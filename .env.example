# Sanity — exposed to the client (Studio + build queries). Safe to be public.
PUBLIC_SANITY_PROJECT_ID=your_project_id
PUBLIC_SANITY_DATASET=production

# Sanity — server-side only. Used by the one-off content import script.
# Create at https://www.sanity.io/manage → API → Tokens (Editor permission).
# NEVER commit this value.
SANITY_WRITE_TOKEN=your_write_token

# Google sign-in (Auth.js) — powers the team self-service page /equipo/editar.
# 1. Create OAuth credentials at https://console.cloud.google.com/apis/credentials
#    (consent screen → "Internal" so only your Workspace can sign in).
# 2. Authorized redirect URIs:
#    - http://localhost:4321/api/auth/callback/google   (local dev)
#    - https://laotraciudad.org/api/auth/callback/google (production)
# AUTH_SECRET: random string, e.g. `openssl rand -base64 32`. NEVER commit these.
AUTH_SECRET=your_random_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Resend — server-side only. Powers the /api/contact form endpoint.
# Create at https://resend.com → API Keys. NEVER commit this value.
RESEND_API_KEY=your_resend_api_key
# Optional overrides (defaults shown). FROM must be on a domain you verified in Resend.
CONTACT_TO_EMAIL=info@laotraciudad.org
CONTACT_FROM_EMAIL=web@laotraciudad.org

# Wompi (Bancolombia) — powers the /api/donate donation flow.
# Get both at https://comercios.wompi.co → Desarrolladores.
#
# Production keys (used when WOMPI_PUBLICA is set).
WOMPI_PUBLICA=pub_prod_xxxxxxxxxxxxxxxxxxxx
WOMPI_INTEGRITY=prod_integrity_xxxxxxxxxxxxxxxxxxxx
#
# Test keys (fallback when prod keys are absent — use for local dev).
WOMPI_PUBLIC_TEST=pub_test_xxxxxxxxxxxxxxxxxxxx
WOMPI_INTEGRITY_TEST=test_integrity_xxxxxxxxxxxxxxxxxxxx
