---
import BaseLayout from '../components/layout/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getFeaturedProjects } from '../lib/sanity';
import { Image } from 'astro:assets';
import sanRafael2 from '../../public/images/projects/fotos_intervenciones/san_rafael_2.jpg';

const featured = await getFeaturedProjects(5);

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: 'Corporación La Otra Ciudad',
  url: 'https://laotraciudad.org',
  logo: 'https://laotraciudad.org/images/logo.svg',
  description: 'Corporación sin ánimo de lucro que co-crea ciudades más justas, sostenibles y saludables en Medellín, Colombia.',
  foundingDate: '2021',
  areaServed: { '@type': 'City', name: 'Medellín', containedInPlace: { '@type': 'Country', name: 'Colombia' } },
  contactPoint: { '@type': 'ContactPoint', email: 'info@laotraciudad.org', contactType: 'customer service' },
  sameAs: [],
};
---

<BaseLayout
  title="Inicio"
  description="Corporación La Otra Ciudad — co-creamos ciudades más biodiversas, justas y saludables junto a comunidades de Medellín, Colombia."
  jsonLd={orgSchema}
  pageColor="cobalt"
>

  <!-- ─── HERO ──────────────────────────────────────────────────────── -->
  <section class="hero">
    <span class="hero-eyebrow">Corporación La Otra Ciudad · Medellín</span>
    <h1 class="hero-title">Construimos ciudades más biodiversas, justas y saludables</h1>
    <p class="hero-sub">Transformamos territorios desde adentro, con las comunidades, para las comunidades.</p>
    <div class="hero-actions">
      <a href="/proyectos" class="btn-hero-primary">Ver proyectos</a>
      <a href="/quienes-somos" class="btn-hero-secondary">Quiénes somos</a>
    </div>
  </section>

  <!-- ─── STATS ─────────────────────────────────────────────────────── -->
  <!-- EDIT: update numbers as the organization grows -->
  <div class="stats-strip">
    {[
      ['1.035+', 'm² de espacio público transformado', 'var(--c-orange)'],
      ['393',    'Plantas nativas sembradas',           'var(--c-teal)'],
      ['21',     'Talleres con comunidades',            'var(--c-cobalt)'],
      ['2',   'Premios internacionales',                   'var(--c-pink)'],
    ].map(([num, label, color]) => (
      <div class="stat-item">
        <div class="stat-num" style={`color: ${color};`}>{num}</div>
        <div class="stat-label">{label}</div>
      </div>
    ))}
  </div>

  <!-- ─── MISSION INTRO ─────────────────────────────────────────────── -->
  <div class="section">
    <div class="two-col">
      <div>
        <span class="eyebrow">Nuestra misión</span>
        <h2 class="section-title">Mejoramos la calidad de vida de comunidades urbanas y dignificamos los territorios que habitan</h2>
        <p class="section-body">
          Somos una corporación sin ánimo de lucro fundada en Medellín en 2021. Trabajamos mediante
          soluciones basadas en la naturaleza, diseño participativo de espacio público, intervenciones
          artísticas y fortalecimiento del tejido social, siempre junto a las comunidades.
        </p>
        <div style="margin-top: 28px; display: flex; gap: 12px; flex-wrap: wrap;">
          <a href="/quienes-somos" class="btn-accent">Conocernos</a>
          <a href="/metodologia" class="btn-outline">Nuestra metodología</a>
        </div>
      </div>
      <div>
        <Image
          src={sanRafael2}
          alt="Comunidad San Rafael"
          width={600}
          height={400}
          style="width: 100%; aspect-ratio: 3/2; object-fit: cover; border-radius: 12px; display: block;"
        />
      </div>
    </div>
  </div>

  <!-- ─── FEATURED PROJECTS ─────────────────────────────────────────── -->
  <div class="section-full section-warm" style="padding: 80px 0;">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 48px; display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 40px; flex-wrap: wrap; gap: 16px;">
      <div>
        <span class="eyebrow">Nuestro trabajo</span>
        <h2 class="section-title">Transformaciones recientes</h2>
      </div>
      <a href="/proyectos" class="btn-outline">Ver todos →</a>
    </div>

    <div class="carousel-outer" id="proj-carousel">
      <div class="carousel-track" id="proj-track">
        {[...featured, ...featured].map((project, i) => (
          <div class="carousel-item" aria-hidden={i >= featured.length ? 'true' : undefined}>
            <ProjectCard
              title={project.title}
              slug={project.slug}
              category={project.category}
              summary={project.summary}
              heroImage={project.heroImage}
              status={project.status}
              year={project.year}
            />
          </div>
        ))}
      </div>
    </div>
  </div>

  <style>
    .carousel-outer {
      overflow: hidden;
      cursor: grab;
      user-select: none;
      -webkit-user-select: none;
      padding: 4px 0 28px;
    }
    .carousel-outer.is-dragging { cursor: grabbing; }
    .carousel-outer.is-dragging a { pointer-events: none; }

    .carousel-track {
      display: flex;
      gap: 24px;
      padding: 0 48px;
      will-change: transform;
    }

    .carousel-item {
      flex: 0 0 360px;
      min-width: 0;
    }

    @media (max-width: 600px) {
      .carousel-item { flex: 0 0 280px; }
      .carousel-track { padding: 0 24px; }
    }
  </style>

  <script>
    const outer = document.getElementById('proj-carousel');
    const track = document.getElementById('proj-track');
    const items = track.querySelectorAll('.carousel-item');
    const N = items.length / 2;

    let pos = 0;
    let dragging = false;
    let didDrag = false;
    let startX = 0;
    let startPos = 0;

    function loopWidth() {
      const gap = parseFloat(getComputedStyle(track).gap) || 0;
      return N * (items[0].offsetWidth + gap);
    }

    function wrap(p) {
      const lw = loopWidth();
      return ((p % lw) + lw) % lw;
    }

    function render() {
      track.style.transform = `translateX(-${pos}px)`;
    }

    function stopDrag() {
      if (!dragging) return;
      dragging = false;
      outer.classList.remove('is-dragging');
    }

    // Prevent the browser from starting a native link/image drag, which would
    // steal mousemove events and break drag-scrolling over cards.
    outer.addEventListener('dragstart', e => e.preventDefault());

    outer.addEventListener('mousedown', e => {
      dragging = true;
      didDrag = false;
      startX = e.clientX;
      startPos = pos;
      outer.classList.add('is-dragging');
    });

    window.addEventListener('mousemove', e => {
      if (!dragging) return;
      const dx = startX - e.clientX;
      if (Math.abs(dx) > 5) didDrag = true;
      pos = wrap(startPos + dx);
      render();
    });

    window.addEventListener('mouseup', stopDrag);
    // Stops drag if cursor leaves the browser window entirely
    document.addEventListener('mouseleave', stopDrag);

    // Suppress card navigation after a drag (but allow plain clicks)
    outer.addEventListener('click', e => {
      if (didDrag) {
        e.preventDefault();
        e.stopPropagation();
        didDrag = false;
      }
    }, true);

    outer.addEventListener('touchstart', e => {
      startX = e.touches[0].clientX;
      startPos = pos;
      didDrag = false;
    }, { passive: true });
    outer.addEventListener('touchmove', e => {
      pos = wrap(startPos + (startX - e.touches[0].clientX));
      render();
    }, { passive: true });

    // Trackpad horizontal swipe only; ignore vertical so page scroll works normally
    outer.addEventListener('wheel', e => {
      if (Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;
      e.preventDefault();
      pos = wrap(pos + e.deltaX);
      render();
    }, { passive: false });

    // Start with the last card peeking ~45% from the left edge so it's
    // immediately obvious this is a scrollable carousel.
    pos = wrap(-(items[0].offsetWidth * 0.45));
    render();
  </script>

  <!-- ─── QUOTE BANNER ──────────────────────────────────────────────── -->
  <div style="background: var(--c-grad-hero); padding: 96px 48px;">
    <div style="max-width: 900px; margin: 0 auto; text-align: center;">
      <span class="eyebrow-light">Nuestra misión</span>
      <p style="font-family: var(--font-display); font-variation-settings: 'opsz' 144, 'SOFT' 30, 'WONK' 0; font-size: clamp(32px, 4vw, 52px); font-weight: 400; line-height: 1.15; letter-spacing: -1px; color: #fff; margin: 0 0 40px;">
        Promovemos ciudades biodiversas, justas y saludables junto a comunidades históricamente marginadas.
      </p>
      <a href="/donar" class="btn-hero-primary" style="font-size: 16px;">Apoya nuestro trabajo ↗</a>
    </div>
  </div>

  <!-- ─── METHODOLOGY PREVIEW ───────────────────────────────────────── -->
  <div class="section">
    <span class="eyebrow">Cómo trabajamos</span>
    <div class="two-col" style="gap: 64px; margin-top: 8px; align-items: start;">
      <h2 class="section-title">Un proceso centrado en la comunidad</h2>
      <div>
        <p class="section-body" style="margin-top: 0;">
          Nuestra metodología parte del reconocimiento de los saberes populares como base para la
          transformación social. Combinamos aprendizaje basado en proyectos, investigación de impacto
           y formación ciudadana.
        </p>
        <div class="feature-band">
          {[
            ['01', 'Escuchar',   'Procesos de diagnóstico participativo con la comunidad'],
            ['02', 'Co-diseñar', 'Talleres de co-diseño y co-creación de soluciones'],
            ['03', 'Actuar',     'Implementación participativa con acompañamiento técnico'],
          ].map(([n, t, d]) => (
            <div class="feature-item">
              <div style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.6px; color: var(--c-teal); margin-bottom: 6px;">{n}</div>
              <div class="feature-title">{t}</div>
              <div class="feature-desc">{d}</div>
            </div>
          ))}
        </div>
        <a href="/metodologia" class="btn-outline" style="margin-top: 28px;">Ver metodología completa →</a>
      </div>
    </div>
  </div>

  <!-- ─── DONATE CTA ────────────────────────────────────────────────── -->
  <div class="section-full section-gradient" style="padding: 96px 48px; text-align: center;">
    <span class="eyebrow-light">Sé parte del cambio</span>
    <h2 style="font-family: var(--font-display); font-variation-settings: 'opsz' 144, 'SOFT' 30, 'WONK' 0; font-size: clamp(36px, 5vw, 60px); font-weight: 400; line-height: 1.1; letter-spacing: -1.2px; color: #fff; max-width: 640px; margin: 0 auto 20px;">
      Tu donación construye ciudad
    </h2>
    <p style="font-size: 18px; font-weight: 300; color: rgba(255,255,255,0.8); max-width: 480px; margin: 0 auto 36px; line-height: 1.5;">
      Cada aporte, por pequeño que sea, llega directamente a nuestros programas comunitarios.
    </p>
    <a href="/donar" class="btn-hero-primary" style="font-size: 16px;">Quiero donar</a>
  </div>

</BaseLayout>
