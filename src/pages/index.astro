---
import BaseLayout from '../components/layout/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import FlowerDiagram from '../components/FlowerDiagram.astro';
import { getFeaturedProjects } from '../lib/sanity';
import { Image } from 'astro:assets';
import sanRafael2 from '../../public/images/projects/fotos_intervenciones/san_rafael_2.jpg';

const featured = await getFeaturedProjects(5);

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: 'Corporación La Otra Ciudad',
  url: 'https://laotraciudad.org',
  logo: 'https://laotraciudad.org/images/logo.svg',
  description: 'Corporación sin ánimo de lucro que co-crea ciudades más justas, sostenibles y saludables en Medellín, Colombia.',
  foundingDate: '2021',
  areaServed: { '@type': 'City', name: 'Medellín', containedInPlace: { '@type': 'Country', name: 'Colombia' } },
  contactPoint: { '@type': 'ContactPoint', email: 'info@laotraciudad.org', contactType: 'customer service' },
  sameAs: [],
};
---

<BaseLayout
  title="Inicio"
  description="Corporación La Otra Ciudad — co-creamos ciudades más biodiversas, justas y saludables junto a comunidades de Medellín, Colombia."
  jsonLd={orgSchema}
  pageColor="cobalto"
>

  <!-- ─── HERO ──────────────────────────────────────────────────────── -->
  <section class="hero">
    <span class="hero-eyebrow">Corporación La Otra Ciudad · Medellín</span>
    <h1 class="hero-title">Construimos ciudades más biodiversas, justas y saludables</h1>
    <p class="hero-sub">Transformamos territorios desde adentro, con las comunidades, para las comunidades.</p>
    <button class="hero-scroll-btn" onclick="document.getElementById('hero-next').scrollIntoView({behavior:'smooth'})" aria-label="Desplazarse hacia abajo">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9"/>
      </svg>
    </button>
  </section>

  <!-- ─── MISSION INTRO ─────────────────────────────────────────────── -->
  <div id="hero-next" class="section">
    <div class="two-col">
      <div>
        <span class="eyebrow">Nuestra misión</span>
        <h2 class="section-title">Construimos territorios dignos para quienes más lo necesitan</h2>
        <p class="section-body">
          Somos una corporación sin ánimo de lucro fundada en Medellín en 2021. Trabajamos mediante
          soluciones basadas en la naturaleza, diseño participativo de espacio público, intervenciones
          artísticas y fortalecimiento del tejido social, siempre junto a las comunidades.
        </p>
        <div style="margin-top: 28px; display: flex; gap: 12px; flex-wrap: wrap;">
          <a href="/quienes-somos" class="btn-accent">Quiénes somos</a>
          <a href="/metodologia" class="btn-outline">Nuestra metodología</a>
        </div>
      </div>
      <div>
        <Image
          src={sanRafael2}
          alt="Comunidad San Rafael"
          width={600}
          height={400}
          style="width: 100%; aspect-ratio: 3/2; object-fit: cover; border-radius: 12px; display: block;"
        />
      </div>
    </div>
  </div>

  <!-- ─── STATS ─────────────────────────────────────────────────────── -->
  <!-- EDIT: update numbers as the organization grows -->
  {(() => {
    const A = 'M 10,60 C 5,36 28,12 68,9 C 108,6 158,20 178,40 C 196,58 186,78 158,84 C 130,90 72,88 38,78 C 14,70 14,80 10,60 Z';
    const B = 'M 22,14 C 52,4 126,8 162,26 C 190,40 192,64 170,76 C 148,88 96,90 56,84 C 20,78 4,60 6,42 C 8,22 8,22 22,14 Z';
    const stats: [string, string, string, string, string][] = [
      ['1.035+', 'm² de espacio público transformado', 'var(--c-orange)', A, ''],
      ['393',    'Plantas nativas sembradas',           'var(--c-aguamarina)',   B, ''],
      ['21',     'Talleres con comunidades',            'var(--c-cobalto)', A, 'scale(-1 1) translate(-200 0)'],
      ['2',      'Premios internacionales',             'var(--c-rosado)',   B, 'rotate(180 100 50)'],
    ];
    return (
      <div class="stats-strip" style="background-image: linear-gradient(135deg, rgba(26,20,16,0.84) 0%, rgba(42,26,10,0.76) 55%, rgba(59,26,26,0.70) 100%), url('/images/projects/alto_flores/alto_flores3.jpg'); background-size: cover; background-position: center;">
        {stats.map(([num, label, color, path, tf]) => (
          <div class="stat-item">
            <svg class="stat-blob" viewBox="0 0 200 100" aria-hidden="true">
              <path fill={color} fill-opacity="0.22" d={path} transform={tf || undefined} />
            </svg>
            <div class="stat-num" style={`color: ${color};`}>{num}</div>
            <div class="stat-label">{label}</div>
          </div>
        ))}
      </div>
    );
  })()}

  <!-- ─── METHODOLOGY PREVIEW ───────────────────────────────────────── -->
  <div class="section">
    <span class="eyebrow">Cómo trabajamos</span>
    <h2 class="section-title">Un proceso centrado en la comunidad</h2>

    <div class="two-col" style="gap: 72px; align-items: center; margin-top: 32px;">

      <!-- Columna izquierda: diagrama -->
      <div>
        <FlowerDiagram />
      </div>

      <!-- Columna derecha: párrafo -->
      <div>
        <p class="section-body" style="margin-top: 0;">
          En La Otra Ciudad creemos que transformar una ciudad empieza por mirarla como lo que es:
          un ecosistema vivo, donde las personas, los barrios y la naturaleza forman parte de un mismo
          tejido. Desde ahí trabajamos, no para imponer soluciones, sino para regenerar ese tejido
          junto a quienes lo habitan.
        </p>
        <p class="section-body">
          Los cuatro valores que guían nuestro diseño no son ideas sueltas, sino las piezas de una
          misma forma de entender la ciudad. Haz click en el diagrama y descubre más sobre ellos.
        </p>
      </div>

    </div>
  </div>

  <!-- ─── QUOTE BANNER ──────────────────────────────────────────────── -->
  <div style="background: var(--c-grad-hero); padding: 96px 48px;">
    <div style="max-width: 900px; margin: 0 auto; text-align: center;">
      <span class="eyebrow-light">Nuestra misión</span>
      <p style="font-family: var(--font-display); font-variation-settings: 'opsz' 144, 'SOFT' 30, 'WONK' 0; font-size: clamp(32px, 4vw, 52px); font-weight: 400; line-height: 1.15; letter-spacing: -1px; color: #fff; margin: 0 0 40px;">
        Promover el desarrollo sostenible de comunidades urbanas vulnerables, mejorando su calidad de vida y dignificando los territorios que habitan
      </p>
      <a href="/donar" class="btn-hero-primary" style="font-size: 16px;">Apoya nuestro trabajo ↗</a>
    </div>
  </div>

  <!-- ─── FEATURED PROJECTS ─────────────────────────────────────────── -->
  <div class="section-full section-warm" style="padding: 80px 0;">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 48px; display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 40px; flex-wrap: wrap; gap: 16px;">
      <div>
        <span class="eyebrow">Nuestro trabajo</span>
        <h2 class="section-title">Transformaciones recientes</h2>
      </div>
      <a href="/proyectos" class="btn-outline">Ver todos →</a>
    </div>

    <div class="carousel-outer" id="proj-carousel">
      <div class="carousel-track" id="proj-track">
        {[...featured, ...featured].map((project, i) => (
          <div class="carousel-item" aria-hidden={i >= featured.length ? 'true' : undefined}>
            <ProjectCard
              title={project.title}
              slug={project.slug}
              category={project.category}
              summary={project.summary}
              heroImage={project.heroImage}
              status={project.status}
              year={project.year}
            />
          </div>
        ))}
      </div>
    </div>
  </div>

  <style>
    .carousel-outer {
      overflow: hidden;
      cursor: grab;
      user-select: none;
      -webkit-user-select: none;
      padding: 4px 0 28px;
    }
    .carousel-outer.is-dragging { cursor: grabbing; }
    .carousel-outer.is-dragging a { pointer-events: none; }

    .carousel-track {
      display: flex;
      gap: 24px;
      padding: 0 48px;
      will-change: transform;
    }

    .carousel-item {
      flex: 0 0 360px;
      min-width: 0;
    }

    @media (max-width: 600px) {
      .carousel-item { flex: 0 0 280px; }
      .carousel-track { padding: 0 24px; }
    }
  </style>

  <script>
    const outer = document.getElementById('proj-carousel');
    const track = document.getElementById('proj-track');
    const items = track.querySelectorAll('.carousel-item');
    const N = items.length / 2;

    let pos = 0;
    let dragging = false;
    let didDrag = false;
    let startX = 0;
    let startPos = 0;

    function loopWidth() {
      const gap = parseFloat(getComputedStyle(track).gap) || 0;
      return N * (items[0].offsetWidth + gap);
    }

    function wrap(p) {
      const lw = loopWidth();
      return ((p % lw) + lw) % lw;
    }

    function render() {
      track.style.transform = `translateX(-${pos}px)`;
    }

    function stopDrag() {
      if (!dragging) return;
      dragging = false;
      outer.classList.remove('is-dragging');
    }

    // Prevent the browser from starting a native link/image drag, which would
    // steal mousemove events and break drag-scrolling over cards.
    outer.addEventListener('dragstart', e => e.preventDefault());

    outer.addEventListener('mousedown', e => {
      dragging = true;
      didDrag = false;
      startX = e.clientX;
      startPos = pos;
      outer.classList.add('is-dragging');
    });

    window.addEventListener('mousemove', e => {
      if (!dragging) return;
      const dx = startX - e.clientX;
      if (Math.abs(dx) > 5) didDrag = true;
      pos = wrap(startPos + dx);
      render();
    });

    window.addEventListener('mouseup', stopDrag);
    // Stops drag if cursor leaves the browser window entirely
    document.addEventListener('mouseleave', stopDrag);

    // Suppress card navigation after a drag (but allow plain clicks)
    outer.addEventListener('click', e => {
      if (didDrag) {
        e.preventDefault();
        e.stopPropagation();
        didDrag = false;
      }
    }, true);

    outer.addEventListener('touchstart', e => {
      startX = e.touches[0].clientX;
      startPos = pos;
      didDrag = false;
    }, { passive: true });
    outer.addEventListener('touchmove', e => {
      pos = wrap(startPos + (startX - e.touches[0].clientX));
      render();
    }, { passive: true });

    // Trackpad horizontal swipe only; ignore vertical so page scroll works normally
    outer.addEventListener('wheel', e => {
      if (Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;
      e.preventDefault();
      pos = wrap(pos + e.deltaX);
      render();
    }, { passive: false });

    // Start with the last card peeking ~45% from the left edge so it's
    // immediately obvious this is a scrollable carousel.
    pos = wrap(-(items[0].offsetWidth * 0.45));
    render();
  </script>

  <!-- ─── DONATE CTA ────────────────────────────────────────────────── -->
  <div class="section-full section-gradient" style="padding: 96px 48px; text-align: center;">
    <span class="eyebrow-light">Sé parte del cambio</span>
    <h2 style="font-family: var(--font-display); font-variation-settings: 'opsz' 144, 'SOFT' 30, 'WONK' 0; font-size: clamp(36px, 5vw, 60px); font-weight: 400; line-height: 1.1; letter-spacing: -1.2px; color: #fff; margin: 0 auto 20px;">
      Tu donación construye ciudad
    </h2>
    <p style="font-size: 18px; font-weight: 300; color: rgba(255,255,255,0.8); max-width: 480px; margin: 0 auto 36px; line-height: 1.5;">
      Cada aporte, por pequeño que sea, llega directamente a nuestros programas comunitarios.
    </p>
    <a href="/donar" class="btn-hero-primary" style="font-size: 16px;">Quiero donar</a>
  </div>


<script>
  (() => {
    const strip = document.querySelector('.stats-strip');
    if (!strip) return;

    // Parse numeric value from strings like "1.035+", "393", "21", "2"
    function parseValue(str: string): { prefix: string; value: number; suffix: string } {
      const m = str.match(/^([^\d]*)(\d[\d.,]*)(.*)$/);
      if (!m) return { prefix: '', value: 0, suffix: str };
      return {
        prefix: m[1],
        value: parseFloat(m[2].replace(/\./g, '').replace(',', '.')),
        suffix: m[3],
      };
    }

    function easeOutExpo(t: number): number {
      return t === 1 ? 1 : 1 - Math.pow(2, -10 * t);
    }

    function countUp(el: HTMLElement, delay: number) {
      const raw = el.dataset.value ?? el.textContent?.trim() ?? '0';
      const { prefix, value, suffix } = parseValue(raw);
      const duration = 1400;
      let start: number | null = null;

      const useDecimalDot = raw.includes('.');
      const formatted = (n: number) => {
        const rounded = Math.round(n);
        if (useDecimalDot && value >= 1000) {
          return rounded.toLocaleString('de-DE').replace(/,/g, '.');
        }
        return String(rounded);
      };

      el.textContent = prefix + '0' + suffix;

      setTimeout(() => {
        const step = (ts: number) => {
          if (!start) start = ts;
          const progress = Math.min((ts - start) / duration, 1);
          el.textContent = prefix + formatted(easeOutExpo(progress) * value) + suffix;
          if (progress < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      }, delay);
    }

    // Store original values before any manipulation
    strip.querySelectorAll<HTMLElement>('.stat-num').forEach(el => {
      el.dataset.value = el.textContent?.trim() ?? '';
    });

    // Set initial state for entrance animation
    strip.querySelectorAll<HTMLElement>('.stat-item').forEach(item => {
      item.style.opacity = '0';
      item.style.transform = 'translateY(20px)';
    });

    const obs = new IntersectionObserver(entries => {
      if (!entries[0].isIntersecting) return;
      obs.disconnect();

      strip.querySelectorAll<HTMLElement>('.stat-item').forEach((item, i) => {
        const delay = i * 120;
        setTimeout(() => {
          item.style.transition = 'opacity 500ms ease, transform 500ms ease';
          item.style.opacity = '1';
          item.style.transform = 'translateY(0)';
          const numEl = item.querySelector<HTMLElement>('.stat-num');
          if (numEl) countUp(numEl, 0);
        }, delay);
      });
    }, { threshold: 0.25 });

    obs.observe(strip);
  })();
</script>

</BaseLayout>
