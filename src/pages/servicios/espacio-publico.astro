---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import PageHero from '../../components/layout/PageHero.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjectsByCategory } from '../../lib/sanity';

const projects = await getProjectsByCategory('Espacio Público');
---

<BaseLayout
  title="Espacio Público"
  description="Diseñamos espacios públicos que invitan a quedarse: lugares activos, seguros y disfrutables, con identidad propia, que la gente elige habitar y que dinamizan la vida social y económica del entorno."
  pageColor="cobalt"
>
  <PageHero type="banner" eyebrow="Servicios · Diseño de" image="/images/banners/espacios_publicos.jpg">
    <h1 class="page-hero-title">Espacio Público</h1>
    <p class="page-hero-sub">
      Diseñamos espacios públicos que invitan a quedarse: lugares activos, seguros y disfrutables, con identidad propia, que la gente elige habitar y que dinamizan la vida social y económica del entorno.
    </p>
  </PageHero>

  <!-- ─── DESCRIPCIÓN ───────────────────────────────────────────────────── -->
  <div class="section">
    <div class="two-col">
      <div>
        <span class="eyebrow">Qué hacemos</span>
        <!-- EDIT: ajustar título -->
        <h2 class="section-title">Lugares que la gente elige habitar</h2>
      </div>
      <div>
        <!-- EDIT: descripción del servicio -->
        <p class="section-body" style="margin-top: 0;">
          Cada espacio público es una oportunidad para reactivar la vida colectiva de un barrio.
          Diseñamos parques de bolsillo, plazoletas y espacios de encuentro que responden a las
          necesidades específicas del territorio, considerando seguridad, accesibilidad y calidad
          espacial desde el primer trazo.
        </p>
        <p class="section-body">
          Nuestro trabajo va más allá del diseño: acompañamos la gestión ante entidades públicas
          y privadas, y exploramos formatos no convencionales cuando el contexto así lo exige.
        </p>
      </div>
    </div>
  </div>

  <!-- ─── PROYECTOS ──────────────────────────────────────────────────────── -->
  {projects.length > 0 && (
    <div class="section-full section-warm" style="padding: 64px 0 80px;">
      <div style="max-width: 1200px; margin: 0 auto; padding: 0 48px;">
        <span class="eyebrow">Nuestra experiencia</span>
        <h2 class="section-title" style="margin-bottom: 40px;">Proyectos relacionados</h2>
        <div class="card-grid-3">
          {projects.map(p => (
            <ProjectCard
              title={p.title}
              slug={p.slug}
              category={p.category}
              summary={p.summary}
              heroImage={p.heroImage}
              status={p.status}
              year={p.year}
            />
          ))}
        </div>
      </div>
    </div>
  )}

  <!-- ─── CTA ────────────────────────────────────────────────────────────── -->
  <div class="section-full" style="background: var(--c-cobalt); padding: 72px 48px; text-align: center;">
    <span style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.6px; text-transform: uppercase; color: rgba(255,255,255,0.6);">
      ¿Tienes un espacio que transformar?
    </span>
    <h2 style="font-family: var(--font-display); font-variation-settings: 'opsz' 144, 'SOFT' 30, 'WONK' 0; font-size: clamp(28px, 4vw, 48px); font-weight: 400; letter-spacing: -1px; line-height: 1.1; color: #fff; max-width: 560px; margin: 16px auto 24px;">
      Conversemos sobre tu territorio
    </h2>
    <a href="/contacto" class="btn-hero-primary" style="background: #fff; color: var(--c-cobalt);">Escríbenos →</a>
  </div>

</BaseLayout>
