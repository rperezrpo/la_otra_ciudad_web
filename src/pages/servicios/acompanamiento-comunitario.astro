---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import PageHero from '../../components/layout/PageHero.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjectsByCategory } from '../../lib/sanity';

const projects = await getProjectsByCategory('Acompañamiento Comunitario');
---

<BaseLayout
  title="Acompañamiento Comunitario"
  description="Acompañamos organizaciones e instituciones en procesos de incidencia territorial, garantizando procesos de participación ciudadana y diagnósticos territoriales sensibles, eficientes y rigurosos."
  pageColor="purple"
>
  <PageHero type="banner" eyebrow="Servicios · Procesos de" image="/images/banners/acompanamiento_comunitario.jpg">
    <h1 class="page-hero-title">Acompañamiento Comunitario</h1>
    <p class="page-hero-sub">
      Acompañamos organizaciones e instituciones en procesos de incidencia territorial, garantizando procesos de participación ciudadana y diagnósticos territoriales sensibles, eficientes y rigurosos.
    </p>
  </PageHero>

  <!-- ─── DESCRIPCIÓN ───────────────────────────────────────────────────── -->
  <div class="section">
    <div class="two-col">
      <div>
        <span class="eyebrow">Qué hacemos</span>
        <!-- EDIT: ajustar título -->
        <h2 class="section-title">La voz de la comunidad en las decisiones del territorio</h2>
      </div>
      <div>
        <!-- EDIT: descripción del servicio -->
        <p class="section-body" style="margin-top: 0;">
          Acompañamos a organizaciones e instituciones en los procesos que permiten que las
          comunidades incidan en las decisiones sobre su territorio. Combinamos herramientas
          de diagnóstico participativo, cartografía social y facilitación para garantizar
          procesos rigurosos y sensibles al contexto local.
        </p>
        <p class="section-body">
          Nuestro equipo interdisciplinar — con formación en diseño urbano, ciencias políticas,
          derecho y biología — garantiza que cada proceso sea técnicamente sólido y
          socialmente significativo.
        </p>
      </div>
    </div>
  </div>

  <!-- ─── PROYECTOS ──────────────────────────────────────────────────────── -->
  {projects.length > 0 && (
    <div class="section-full section-warm" style="padding: 64px 0 80px;">
      <div style="max-width: 1200px; margin: 0 auto; padding: 0 48px;">
        <span class="eyebrow">Nuestra experiencia</span>
        <h2 class="section-title" style="margin-bottom: 40px;">Proyectos relacionados</h2>
        <div class="card-grid-3">
          {projects.map(p => (
            <ProjectCard
              title={p.title}
              slug={p.slug}
              category={p.category}
              summary={p.summary}
              heroImage={p.heroImage}
              status={p.status}
              year={p.year}
            />
          ))}
        </div>
      </div>
    </div>
  )}

  <!-- ─── CTA ────────────────────────────────────────────────────────────── -->
  <div class="section-full" style="background: var(--c-purple); padding: 72px 48px; text-align: center;">
    <span style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.6px; text-transform: uppercase; color: rgba(255,255,255,0.6);">
      ¿Necesitás acompañamiento en tu proceso?
    </span>
    <h2 style="font-family: var(--font-display); font-variation-settings: 'opsz' 144, 'SOFT' 30, 'WONK' 0; font-size: clamp(28px, 4vw, 48px); font-weight: 400; letter-spacing: -1px; line-height: 1.1; color: #fff; max-width: 560px; margin: 16px auto 24px;">
      Conversemos sobre tu territorio
    </h2>
    <a href="/contacto" class="btn-hero-primary" style="background: #fff; color: var(--c-purple);">Escríbenos →</a>
  </div>

</BaseLayout>
