---
export const prerender = false;

import BaseLayout from '../../../components/layout/BaseLayout.astro';
import { getSessionEmail, isProjectEditor } from '../../../lib/access';
import { getProjectForEdit } from '../../../lib/sanity';
import { CATEGORY_KEYS, CATEGORY_META } from '../../../i18n/categories';

const { slug } = Astro.params;
const email = await getSessionEmail(Astro.request);
if (!email) return Astro.redirect('/editar');

const isEditor = await isProjectEditor(email);
const project = isEditor && slug ? await getProjectForEdit(slug) : null;
---

<BaseLayout title="Editar proyecto" description="Edición de proyecto." pageColor="cobalto">
  <div class="section" style="max-width: 720px;">
    <p style="margin-bottom: 8px;"><a href="/editar/proyectos" class="link-button">← Volver a la lista</a></p>

    {!isEditor && (
      <div>
        <h1 class="section-title">Sin permisos</h1>
        <p class="section-body" style="margin-top: 16px;">
          Tu cuenta (<strong>{email}</strong>) no puede editar proyectos.
        </p>
      </div>
    )}

    {isEditor && !project && (
      <div>
        <h1 class="section-title">Proyecto no encontrado</h1>
        <p class="section-body" style="margin-top: 16px;">No existe un proyecto con ese identificador.</p>
      </div>
    )}

    {isEditor && project && (
      <div>
        <span class="eyebrow">Proyecto</span>
        <h1 class="section-title" style="font-size: clamp(26px, 2.6vw, 38px);">{project.title.es}</h1>
        <p style="font-size: 13px; color: var(--fg3); margin-top: 4px;">URL: /proyectos/{project.slug} (no editable)</p>

        <form id="project-form" enctype="multipart/form-data" style="margin-top: 28px;">
          <input type="hidden" name="slug" value={project.slug} />

          <div class="form-group">
            <label class="form-label" for="title_es">Título (español)</label>
            <input class="form-input" type="text" id="title_es" name="title_es" value={project.title.es} required />
          </div>

          <div class="form-group">
            <label class="form-label" for="title_en">Título (inglés)</label>
            <input class="form-input" type="text" id="title_en" name="title_en" value={project.title.en} />
            <p style="font-size: 13px; color: var(--fg3); margin-top: 6px;">Los campos en inglés son opcionales: si quedan vacíos, la web en inglés muestra el texto en español.</p>
          </div>

          <div class="form-group">
            <label class="form-label" for="categoria_principal">Categoría principal</label>
            <select class="form-select" id="categoria_principal" name="categoria_principal" required>
              {CATEGORY_KEYS.map((key) => (
                <option value={key} selected={key === project.categoria_principal}>{CATEGORY_META[key].es}</option>
              ))}
            </select>
          </div>

          <div class="form-group">
            <label class="form-label">Categorías (todas las que apliquen)</label>
            <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 6px;">
              {CATEGORY_KEYS.map((key) => (
                <label style="display: flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 400;">
                  <input type="checkbox" name="category" value={key} checked={project.category.includes(key)} />
                  {CATEGORY_META[key].es}
                </label>
              ))}
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="summary_es">Resumen (para las tarjetas, español)</label>
            <textarea class="form-textarea" id="summary_es" name="summary_es" rows="3">{project.summary.es}</textarea>
          </div>

          <div class="form-group">
            <label class="form-label" for="summary_en">Resumen (inglés)</label>
            <textarea class="form-textarea" id="summary_en" name="summary_en" rows="3">{project.summary.en}</textarea>
          </div>

          <div class="form-group">
            <label class="form-label" for="description_es">Descripción (español)</label>
            <details style="margin-bottom: 8px;">
              <summary style="cursor: pointer; font-size: 13px; color: var(--fg3);">¿Cómo dar formato? (Markdown)</summary>
              <ul style="font-size: 13px; color: var(--fg2); margin: 8px 0 0; padding-left: 18px; line-height: 1.7;">
                <li>Para título doble numeral: <code>## Academia</code></li>
                <li>Para subtítulo triple numeral: <code>### Universidad</code></li>
                <li>Negrita doble asterisco: <code>**este texto saldrá en negrita**</code></li>
                <li>Itálicas un sólo asterisco: <code>*este texto saldrá en italicas*</code></li>
                <li>Para listas, comenzar la línea con un guión</li>
                <li>Para enlaces, usar: <code>[texto](https://enlace)</code></li>
              </ul>
            </details>
            <textarea class="form-textarea" id="description_es" name="description_es" rows="14" style="font-family: var(--font-mono); font-size: 14px;">{project.descriptionMarkdown.es}</textarea>
          </div>

          <div class="form-group">
            <label class="form-label" for="description_en">Descripción (inglés)</label>
            <textarea class="form-textarea" id="description_en" name="description_en" rows="14" style="font-family: var(--font-mono); font-size: 14px;">{project.descriptionMarkdown.en}</textarea>
          </div>

          <div class="form-group">
            <label class="form-label" for="neighborhood">Territorio</label>
            <input class="form-input" type="text" id="neighborhood" name="neighborhood" value={project.neighborhood} />
          </div>

          <div class="form-group">
            <label class="form-label" for="partners">Aliados (uno por línea)</label>
            <textarea class="form-textarea" id="partners" name="partners" rows="4">{project.partners.join('\n')}</textarea>
          </div>

          <div class="form-group" style="display: flex; gap: 24px; flex-wrap: wrap;">
            <div style="flex: 1; min-width: 120px;">
              <label class="form-label" for="year">Año</label>
              <input class="form-input" type="number" id="year" name="year" value={project.year ?? ''} min="1990" max="2100" />
            </div>
            <div style="flex: 1; min-width: 160px;">
              <label class="form-label">Estado</label>
              <div style="display: flex; gap: 16px; margin-top: 10px;">
                <label style="display: flex; align-items: center; gap: 6px; font-weight: 400;">
                  <input type="radio" name="status" value="activo" checked={project.status !== 'completado'} /> Activo
                </label>
                <label style="display: flex; align-items: center; gap: 6px; font-weight: 400;">
                  <input type="radio" name="status" value="completado" checked={project.status === 'completado'} /> Completado
                </label>
              </div>
            </div>
          </div>

          <div class="form-group">
            <label style="display: flex; align-items: center; gap: 8px; font-weight: 400;">
              <input type="checkbox" name="featured" checked={project.featured} /> Destacado en la portada
            </label>
          </div>

          <div class="form-group">
            <label class="form-label">Imagen principal</label>
            {project.heroImage && (
              <img src={project.heroImage} alt="Imagen actual" style="width: 100%; max-width: 320px; height: 180px; object-fit: cover; border-radius: 8px; display: block; margin-bottom: 10px;" />
            )}
            <input class="form-input" type="file" name="heroImage" accept="image/jpeg,image/png,image/webp" />
            <p style="font-size: 13px; color: var(--fg3); margin-top: 6px;">Déjalo vacío para conservar la imagen actual.</p>
          </div>

          <div class="form-group">
            <label class="form-label">Galería</label>
            {project.gallery.length > 0 ? (
              <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 10px; margin-bottom: 12px;">
                {project.gallery.map((g) => (
                  <label style="position: relative; cursor: pointer; display: block;">
                    <img src={g.url} alt="" style="width: 100%; height: 90px; object-fit: cover; border-radius: 6px; display: block;" />
                    <span style="display: flex; align-items: center; gap: 6px; font-size: 12px; margin-top: 4px;">
                      <input type="checkbox" name="keepGallery" value={g.key} checked /> Mantener
                    </span>
                  </label>
                ))}
              </div>
            ) : (
              <p style="font-size: 14px; color: var(--fg3); margin-bottom: 10px;">No hay imágenes en la galería.</p>
            )}
            <input class="form-input" type="file" name="galleryNew" accept="image/jpeg,image/png,image/webp" multiple />
            <p style="font-size: 13px; color: var(--fg3); margin-top: 6px;">
              Desmarca "Mantener" para quitar una imagen. Selecciona archivos para agregar nuevas.
            </p>
          </div>

          <button type="submit" class="btn-accent" id="project-submit" style="padding: 14px 28px;">Guardar cambios</button>
          <p id="project-status" role="status" aria-live="polite" style="display: none; margin-top: 16px; font-size: 15px; line-height: 1.5;"></p>
        </form>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .link-button {
    background: none; border: none; padding: 0; font: inherit;
    color: var(--page-accent, var(--c-cobalto)); text-decoration: underline; cursor: pointer;
  }
</style>

<script>
  const form = document.getElementById('project-form') as HTMLFormElement | null;
  const status = document.getElementById('project-status') as HTMLParagraphElement | null;
  const submitBtn = document.getElementById('project-submit') as HTMLButtonElement | null;

  if (form && status && submitBtn) {
    const show = (msg: string, ok: boolean) => {
      status.textContent = msg;
      status.style.display = 'block';
      status.style.color = ok ? 'var(--fg2)' : '#b3261e';
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      submitBtn.disabled = true;
      const label = submitBtn.textContent;
      submitBtn.textContent = 'Guardando…';
      status.style.display = 'none';

      try {
        const res = await fetch('/api/proyectos/actualizar', { method: 'POST', body: new FormData(form) });
        const data = await res.json().catch(() => ({}));
        if (res.ok) {
          show('¡Listo! Los cambios se guardaron. Aparecerán en la web en el próximo despliegue.', true);
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } else {
          show(data.error ?? 'No pudimos guardar los cambios. Intenta de nuevo.', false);
        }
      } catch {
        show('Hubo un problema de conexión. Intenta de nuevo.', false);
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = label;
      }
    });
  }
</script>
