---
import BaseLayout from '../components/layout/BaseLayout.astro';
import PageHero from '../components/layout/PageHero.astro';

// ─── SERVICE CARDS ────────────────────────────────────────────────────────────
// EDIT: update image paths once service-specific photos are available
const services = [
  {
    href:    '/servicios/paisajes-regenerativos',
    label:   'Diseño de',
    title:   'Paisajes Regenerativos',
    desc:    'Transformamos espacios verdes en oasis de vida y biodiversidad que son resilientes a climas extremos y requieren menor mantenimiento que un paisaje artificial.',
    image:   '/images/banners/paisajes_regenerativos.jpg',
    color:   'var(--c-teal)',
  },
  {
    href:    '/servicios/espacio-publico',
    label:   'Diseño de',
    title:   'Espacio Público',
    desc:    'Diseñamos espacios públicos que invitan a quedarse: lugares activos, seguros y disfrutables, con identidad propia, que la gente elige habitar y que dinamizan la vida social y económica del entorno.',
    image:   '/images/banners/espacios_publicos.JPG',
    color:   'var(--c-cobalt)',
  },
  {
    href:    '/servicios/acompanamiento-comunitario',
    label:   'Procesos de',
    title:   'Acompañamiento Comunitario',
    desc:    'Acompañamos organizaciones e instituciones en procesos de incidencia territorial, garantizando procesos de participación ciudadana y diagnósticos territoriales sensibles, eficientes y rigurosos.',
    image:   '/images/banners/acompanamiento_comunitario.jpg',
    color:   'var(--c-purple)',
  },
];

// ─── CLIENTES ─────────────────────────────────────────────────────────────────
// EDIT: add, remove, or reorder clients; set logo: null for text-only tiles
const clientes = [
  { name: 'Parque Explora',         logo: null                                     },
  { name: 'Everyday Homeless',      logo: '/images/allies/everyday-homeless.png'   },
  { name: 'Fundación Mi Sangre',    logo: '/images/allies/mi-sangre.png'           },
  { name: 'Alcaldía de Envigado',   logo: '/images/allies/alcaldia-envigado.png'   },
  { name: 'Alcaldía de Medellín',   logo: '/images/allies/alcaldia-medellin.jpg'   },
  { name: 'S2Cities',               logo: '/images/allies/s2cities.png'            },
  { name: 'ETH Zurich',             logo: '/images/allies/eth-zurich.jpg'          },
  { name: 'UCL Bartlett (DPU)',     logo: '/images/allies/dpu.jpg'                 },
  { name: 'Urbam–EAFIT',            logo: '/images/allies/urbam.jpg'               },
];
---

<BaseLayout
  title="Servicios"
  description="Diseño de paisajes regenerativos, espacio público y acompañamiento comunitario para territorios más justos, verdes y saludables."
  pageColor="orange"
>

  <!-- ─── HERO ──────────────────────────────────────────────────────────── -->
  <PageHero type="banner" eyebrow="Lo que hacemos" image="/images/banners/servicios.jpg">
    <h1 class="page-hero-title">Servicios</h1>
    <p class="page-hero-sub">
      Diseñamos, construimos y acompañamos procesos de transformación territorial
      junto a las comunidades que los habitan.
    </p>
  </PageHero>

  <!-- ─── DESCRIPCIÓN ───────────────────────────────────────────────────── -->
  <div class="section">
    <div class="two-col">
      <div>
        <!-- EDIT: ajustar título si se desea -->
        <span class="eyebrow">Nuestra forma de trabajar</span>
        <h2 class="section-title">Rigor técnico con raíces en la comunidad</h2>
      </div>
      <div>
        <!-- EDIT: texto de descripción general de los servicios -->
        <p class="section-body" style="margin-top: 0;">
          Desde 2021, La Otra Ciudad ha desarrollado proyectos de transformación urbana en
          territorios vulnerables de Medellín y sus municipios, combinando metodologías
          participativas, soluciones basadas en la naturaleza y diseño colaborativo.
        </p>
        <p class="section-body">
          Nuestros servicios nacen de ese trabajo de campo: no ofrecemos soluciones genéricas,
          sino procesos que parten del reconocimiento profundo del territorio y sus comunidades.
          Cada proyecto es una oportunidad para aprender, fortalecer capacidades locales y
          construir ciudad desde adentro.
        </p>
      </div>
    </div>
  </div>

  <!-- ─── CARDS DE SERVICIOS ────────────────────────────────────────────── -->
  <div class="section-full section-warm" style="padding: 64px 0 80px;">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 48px;">
      <div class="services-grid">
        {services.map((s) => (
          <a href={s.href} class="card service-card" style={`--svc-color: ${s.color};`}>
            <!-- Image -->
            <div class="service-card__img-wrap">
              <img
                src={s.image}
                alt={s.title}
                loading="lazy"
                class="service-card__img"
              />
              <div class="service-card__img-overlay" />
            </div>

            <!-- Body -->
            <div class="card-body service-card__body">
              <p class="service-card__label">{s.label}</p>
              <p class="card-title service-card__title">{s.title}</p>
              <p class="card-desc">{s.desc}</p>
              <span class="service-card__cta">Conoce más →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- ─── NUESTROS CLIENTES ─────────────────────────────────────────────── -->
  <div class="section">
    <div style="text-align: center; margin-bottom: 48px;">
      <!-- EDIT: ajustar título -->
      <span class="eyebrow">Con quiénes trabajamos</span>
      <h2 class="section-title" style="margin-top: 8px;">Nuestros clientes</h2>
    </div>

    <div class="clients-grid">
      {clientes.map((c) => (
        <div class="client-tile">
          {c.logo ? (
            <img
              src={c.logo}
              alt={c.name}
              loading="lazy"
              class="client-logo"
            />
          ) : (
            <span class="client-name">{c.name}</span>
          )}
        </div>
      ))}
    </div>
  </div>

  <!-- ─── CTA CONTACTO ──────────────────────────────────────────────────── -->
  <div class="section-full" style="background: var(--c-purple); padding: 72px 48px; text-align: center;">
    <span style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.6px; text-transform: uppercase; color: rgba(255,255,255,0.6);">
      ¿Tienes un proyecto?
    </span>
    <h2 style="font-family: var(--font-display); font-variation-settings: 'opsz' 144, 'SOFT' 30, 'WONK' 0; font-size: clamp(32px, 4.5vw, 52px); font-weight: 400; letter-spacing: -1px; line-height: 1.1; color: #fff; max-width: 640px; margin: 16px auto 24px;">
      Conversemos sobre tu territorio
    </h2>
    <p style="font-size: 17px; font-weight: 300; color: rgba(255,255,255,0.75); max-width: 480px; margin: 0 auto 36px; line-height: 1.6;">
      Cuéntanos en qué está tu comunidad u organización y exploramos juntos cómo acompañarte.
    </p>
    <a href="/contacto" class="btn-hero-primary" style="background: #fff; color: var(--c-purple);">Escríbenos →</a>
  </div>

</BaseLayout>

<style>
  /* ─── SERVICE CARDS GRID ─────────────────────────────────────────────── */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  @media (max-width: 900px) {
    .services-grid { grid-template-columns: 1fr; }
  }

  /* ─── SERVICE CARD ───────────────────────────────────────────────────── */
  .service-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    height: 100%;
  }

  .service-card__img-wrap {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    flex-shrink: 0;
  }

  .service-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 400ms ease;
  }

  .service-card:hover .service-card__img {
    transform: scale(1.04);
  }

  .service-card__img-overlay {
    position: absolute;
    inset: 0;
    background: var(--svc-color);
    opacity: 0;
    transition: opacity 300ms ease;
    mix-blend-mode: multiply;
  }

  .service-card:hover .service-card__img-overlay {
    opacity: 0.18;
  }

  .service-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 4px;
  }

  .service-card__label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.55px;
    text-transform: uppercase;
    color: var(--svc-color);
    margin-bottom: 2px;
  }

  .service-card__title {
    font-size: 20px !important;
    letter-spacing: -0.3px !important;
  }

  .service-card__cta {
    display: inline-block;
    margin-top: 16px;
    font-size: 13px;
    font-weight: 500;
    color: var(--svc-color);
  }

  /* ─── CLIENTS GRID ──────────────────────────────────────────────────── */
  .clients-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
    max-width: 960px;
    margin: 0 auto;
  }

  @media (max-width: 800px) {
    .clients-grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 500px) {
    .clients-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .client-tile {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px 16px;
    background: var(--c-white-pure);
    border-radius: 10px;
    border: 1px solid rgba(26, 20, 16, 0.08);
    min-height: 80px;
    transition: box-shadow 180ms, transform 180ms;
  }

  .client-tile:hover {
    box-shadow: 0 4px 16px rgba(26, 20, 16, 0.08);
    transform: translateY(-2px);
  }

  .client-logo {
    max-width: 100%;
    max-height: 44px;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.65;
    transition: filter 200ms, opacity 200ms;
  }

  .client-tile:hover .client-logo {
    filter: grayscale(0);
    opacity: 1;
  }

  .client-name {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.3px;
    text-align: center;
    color: rgba(26, 20, 16, 0.55);
    line-height: 1.4;
  }
</style>
