---
import BaseLayout from '../components/layout/BaseLayout.astro';
import PersonCard from '../components/PersonCard.astro';
import PageHero from '../components/layout/PageHero.astro';
import { getPeople } from '../lib/sanity';

const peopleData = await getPeople();

// Only show people who have a photo — those without one are silently skipped
const activePeople = peopleData.filter((p) => p.photo && p.state === 'active');
const pastPeople = peopleData.filter((p) => p.state !== 'active');

// EDIT: update the allies list as partnerships change
// logo: path relative to /public — null = text-only tile
const aliados = [
  { name: 'Fundación Mi Sangre',  logo: '/images/allies/mi-sangre.png'          },
  { name: 'S2Cities',             logo: '/images/allies/s2cities.png'            },
  { name: 'Everyday Homeless',    logo: '/images/allies/everyday-homeless.png'   },
  { name: 'UCL Bartlett (DPU)',   logo: '/images/allies/dpu.jpg'                 },
  { name: 'Urbam–EAFIT',          logo: '/images/allies/urbam.jpg'               },
  { name: 'Somos x Naturaleza',   logo: '/images/allies/somos-x-naturaleza.png'  },
  { name: 'ETH Zurich',           logo: '/images/allies/eth-zurich.jpg'          },
  { name: 'Proyecto NN',          logo: '/images/allies/proyecto-nn.jpg'         },
  { name: 'intuyLab',             logo: '/images/allies/intuylab.jpg'            },
  { name: 'Alcaldía de Medellín', logo: '/images/allies/alcaldia-medellin.jpg'   },
  { name: 'Alcaldía de Envigado', logo: '/images/allies/alcaldia-envigado.png'   },
  { name: 'UMI Fund',             logo: null                                      },
  { name: 'Social Change Nest',   logo: null                                      },
  { name: 'Parque Explora',       logo: null                                      },
  { name: 'Low Carbon City',      logo: null                                      },
];
---

<BaseLayout
  title="Quiénes Somos"
  description="La Corporación La Otra Ciudad trabaja desde 2021 por ciudades más biodiversas, justas y saludables en Medellín."
  pageColor="aguamarina"
>

  <!-- ─── PAGE HERO ─────────────────────────────────────────────────── -->
  <!-- EDIT: drop a photo into /public/images/banners/quienes-somos.jpg to activate the image background -->
  <PageHero eyebrow="Quiénes Somos" image="/images/banners/quienes-somos.jpg">
    <h1 class="page-hero-title">Una organización que cree en el poder de lo colectivo</h1>
    <p class="page-hero-sub">Desde 2021 trabajamos para que las comunidades sean protagonistas de la transformación de sus territorios.</p>
  </PageHero>

  <!-- ─── HISTORY ───────────────────────────────────────────────────── -->
  <div class="section">
    <div class="two-col">
      <div>
        <span class="eyebrow">Nuestra historia</span>
        <h2 class="section-title" style="font-size: clamp(28px, 3vw, 42px);">Nacimos de las comunidades, para las comunidades</h2>
        <p class="section-body">
          La Otra Ciudad (LOC) nació en 2021 en Medellín como un colectivo juvenil. Desde su origen
          LOC ha sido liderado por jóvenes urbanistas, arquitectos y activistas apasionados por
          mejorar las ciudades que habitamos. En estos 5 años de trabajo, la organización ha apostado
          por una práctica que pone en el centro los saberes y necesidades de las poblaciones más vulnerables.
        </p>
        <p class="section-body" style="margin-top: 16px;">
          En octubre de 2024 LOC se constituyó formalmente como Entidad Sin Ánimo de Lucro. Hoy la
          integran un equipo de 13 profesionales cuyo trabajo junto a instituciones, empresas y
          comunidades populares para construir espacios más verdes, justos y saludables ha sido
          reconocido nacional e internacionalmente.
        </p>
      </div>
      <div>
        <img
          src="/images/groupal/recorridos_de_ciudad.jpeg"
          alt="Equipo de La Otra Ciudad en recorrido por la ciudad"
          style="width: 100%; height: 420px; object-fit: cover; border-radius: 8px; display: block;"
        />
        <a href="#nuestro-equipo" class="btn-outline" style="display: inline-block; margin-top: 16px;">
          Conoce el equipo →
        </a>
      </div>
    </div>
  </div>

  <!-- ─── VALUES ────────────────────────────────────────────────────── -->
  <div id="valores" class="section-full" style="background: linear-gradient(135deg, #e2611d 0%, #3b6bdc 100%); padding: 80px 48px;">
    <div style="max-width: 1200px; margin: 0 auto;">
      <span class="eyebrow-light">Lo que nos mueve</span>
      <h2 class="section-title" style="color: #fff; max-width: none;">Principios que guían nuestro trabajo</h2>
      <div class="card-grid-4" style="margin-top: 40px;">
        {[
          {
            title: 'Diseño regenerativo',
            desc: 'El proceso de diseño se nutre del aprendizaje continuo a través de la retroalimentación, la reflexión y el diálogo. Construye la capacidad de las personas y del entorno para relacionarse de forma sana a través de la co-evolución.',
            color: 'var(--c-aguamarina)',
          },
          {
            title: 'Co-creación',
            desc: 'Diseñar la ciudad es una tarea colectiva. Trabajamos junto a comunidades, instituciones e investigadores en procesos iterativos para construir soluciones desde el territorio.',
            color: 'var(--c-rosado)',
          },
          {
            title: 'Bienestar Sistémico',
            desc: 'La salud humana, el bienestar económico y la resiliencia ambiental son interdependientes. Para resolver los problemas urbanos es urgente una mirada holística del contexto.',
            color: 'var(--c-violeta)',
          },
          {
            title: 'Derecho a la ciudad',
            desc: 'Todas las personas tienen derecho a habitar, usar y transformar la ciudad. El espacio urbano debe responder a las necesidades humanas, no a las fuerzas del mercado.',
            color: 'var(--c-orange)',
          },
        ].map((v) => (
          <div style={`background: ${v.color}; border-radius: 8px; padding: 36px 32px;`}>
            <h3 style="font-family: var(--font-sans); font-size: 22px; font-weight: 600; letter-spacing: -0.3px; color: #fff; margin-bottom: 12px;">{v.title}</h3>
            <p style="font-size: 15px; font-weight: 300; line-height: 1.6; color: rgba(255,255,255,0.82);">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- ─── TEAM ──────────────────────────────────────────────────────── -->
  <div id="nuestro-equipo" class="section">
    <h2 class="section-title">Nuestro equipo</h2>

    <div class="team-grid" style="margin-top: 40px;">
      {activePeople.map((person) => (
        <PersonCard
          name={person.name}
          role={person.role}
          photo={person.photo}
          bio={person.bio}
          linkedin={person.linkedin}
        />
      ))}
    </div>

    {pastPeople.length > 0 && (
      <details class="past-team">
        <summary class="btn-outline past-team-toggle">
          Personas que nos han acompañado antes
        </summary>
        <div class="past-team-panel">
          <ul class="past-team-list">
            {pastPeople.map((person) => (
              <li>{person.name}</li>
            ))}
          </ul>
        </div>
      </details>
    )}
  </div>

  <!-- ─── ALLIES ────────────────────────────────────────────────────── -->
  <div class="section-full" style="background: linear-gradient(135deg, #e2611d 0%, #3b6bdc 100%); padding: 64px 48px;">
    <div style="max-width: 1200px; margin: 0 auto;">
      <span class="eyebrow-light">Aliados y financiadores</span>
      <!-- EDIT: update aliados array above as alliances change -->
      <div style="display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px;">
        {aliados.map(({ name, logo }) => (
          <div style="background: #fff; border-radius: 8px; padding: 16px 24px; display: flex; align-items: center; justify-content: center; height: 80px; flex: 0 0 auto; min-width: 140px; max-width: 200px;">
            {logo ? (
              <img
                src={logo}
                alt={name}
                title={name}
                style="max-height: 46px; max-width: 160px; width: auto; object-fit: contain; display: block;"
              />
            ) : (
              <span style="font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.5px; text-transform: uppercase; color: var(--fg2); text-align: center; line-height: 1.4;">{name}</span>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>


</BaseLayout>

<style>
  .past-team {
    margin-top: 40px;
  }

  .past-team-toggle {
    list-style: none;
    user-select: none;
  }

  .past-team-toggle::-webkit-details-marker {
    display: none;
  }

  .past-team-toggle::after {
    content: '+';
    font-size: 18px;
    line-height: 1;
    transition: transform 150ms;
  }

  .past-team[open] .past-team-toggle::after {
    content: '–';
  }

  .past-team-panel {
    margin-top: 20px;
    background: var(--c-white-pure);
    border-radius: 8px;
    box-shadow: var(--shadow-sm);
    padding: 28px 32px;
  }

  .past-team-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px 24px;
    margin: 0;
    padding: 0;
  }

  .past-team-list li {
    font-size: 15px;
    font-weight: 300;
    color: var(--fg1);
  }

  @media (max-width: 768px) {
    .past-team-list { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 560px) {
    .past-team-list { grid-template-columns: 1fr; }
  }
</style>
