---
import { pageLang, useTranslations, localizePath, alternatePath, ES_ONLY_PREFIXES } from '../../i18n/ui';
import { CATEGORY_META } from '../../i18n/categories';

const pathname = Astro.url.pathname;
const lang = pageLang(Astro.currentLocale);
const t = useTranslations(lang);
const l = (path: string) => localizePath(lang, path);

// Editor-only routes exist in Spanish only — no language switcher there.
const esOnly = ES_ONLY_PREFIXES.some((p) => pathname.startsWith(p));
const otherLangHref = alternatePath(pathname, lang);
const otherLangLabel = lang === 'es' ? 'EN' : 'ES';

// To add or rename nav links, edit this array.
// Links with `children` render as a hover-dropdown on desktop and as
// indented sub-links in the mobile drawer.
const links = [
  { href: l('/quienes-somos'), label: t('nav.quienesSomos'), color: 'orange', activeClass: 'active-orange' },
  { href: l('/proyectos'),     label: t('nav.proyectos'),      color: 'rosado',   activeClass: 'active-rosado'   },
  { href: l('/metodologia'),   label: t('nav.metodologia'),    color: 'cobalto', activeClass: 'active-cobalto' },
  {
    href: l('/servicios'),
    label: t('nav.servicios'),
    color: 'violeta',
    activeClass: 'active-violeta',
    children: [
      { href: l('/servicios/paisajes-regenerativos'),      label: CATEGORY_META['paisajes-regenerativos'][lang]      },
      { href: l('/servicios/espacio-publico'),             label: CATEGORY_META['espacio-publico'][lang]             },
      { href: l('/servicios/acompanamiento-comunitario'),  label: CATEGORY_META['acompanamiento-comunitario'][lang]  },
    ],
  },
  { href: l('/contacto'),      label: t('nav.contacto'),       color: 'aguamarina',   activeClass: 'active-aguamarina'   },
];

function isActive(href: string) {
  if (href === '/' || href === '/en/') return pathname === href;
  return pathname.startsWith(href);
}
---

<nav class="site-nav">
  <a href={l('/')} class="nav-brand">
    <img
      src="/images/logo/logo_sinBordes_horizontal_color_letraNegra.svg"
      alt="La Otra Ciudad"
      style="height: 28px; width: auto;"
      onerror="this.style.display='none'; this.nextElementSibling.style.display='inline';"
    />
    <span style="display:none;">La Otra Ciudad</span>
  </a>

  <div class="nav-links">
    {links.map((link) =>
      link.children ? (
        <div class="nav-dropdown-wrap">
          <a
            href={link.href}
            class:list={['nav-link', 'nav-link--dropdown', { active: isActive(link.href), [link.activeClass]: isActive(link.href) }]}
            data-color={link.color}
          >
            {link.label}
            <svg class="nav-chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
              <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <div class="nav-dropdown" role="menu">
            {link.children.map((child) => (
              <a
                href={child.href}
                class:list={['nav-dropdown-item', { 'nav-dropdown-item--active': pathname.startsWith(child.href) }]}
                role="menuitem"
              >
                {child.label}
              </a>
            ))}
          </div>
        </div>
      ) : (
        <a
          href={link.href}
          class:list={['nav-link', { active: isActive(link.href), [link.activeClass]: isActive(link.href) }]}
          data-color={link.color}
        >
          {link.label}
        </a>
      )
    )}
  </div>

  {!esOnly && (
    <a href={otherLangHref} class="nav-lang" aria-label={t('nav.cambiarIdioma')}>{otherLangLabel}</a>
  )}

  <a href={l('/donar')} class="nav-cta">{t('nav.donar')}</a>

  <a href={l('/donar')} class="nav-donar-btn" aria-label={t('nav.donarAria')}>$</a>

  <button
    class="nav-hamburger"
    id="nav-hamburger"
    aria-label={t('nav.abrirMenu')}
    aria-expanded="false"
    data-label-open={t('nav.abrirMenu')}
    data-label-close={t('nav.cerrarMenu')}
  >
    <span></span>
    <span></span>
    <span></span>
  </button>
</nav>

<!-- Mobile drawer -->
<div class="nav-drawer" id="nav-drawer" aria-hidden="true">
  <div class="nav-drawer-inner">
    {links.map((link) => (
      <>
        <a
          href={link.href}
          class:list={['nav-drawer-link', { active: isActive(link.href), [link.activeClass]: isActive(link.href) }]}
          data-color={link.color}
        >
          {link.label}
        </a>
        {link.children && link.children.map((child) => (
          <a
            href={child.href}
            class:list={['nav-drawer-sublink', { 'nav-drawer-sublink--active': pathname.startsWith(child.href) }]}
          >
            {child.label}
          </a>
        ))}
      </>
    ))}
    {!esOnly && (
      <a href={otherLangHref} class="nav-drawer-lang">
        {lang === 'es' ? 'English version' : 'Versión en español'}
      </a>
    )}
    <a href={l('/donar')} class="nav-cta nav-drawer-cta">{t('nav.donar')}</a>
  </div>
</div>
<div class="nav-overlay" id="nav-overlay"></div>

<style>
  /* ─── HAMBURGER BUTTON ─────────────────────────────────────────────────── */
  .nav-hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 8px;
    background: transparent;
    border: none;
    cursor: pointer;
    margin-left: auto;
    border-radius: 8px;
    transition: background 120ms;
  }
  .nav-hamburger:hover { background: var(--c-glass-dark); }
  .nav-hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--c-black);
    border-radius: 2px;
    transition: transform 220ms ease, opacity 180ms ease;
    transform-origin: center;
  }
  /* Animated X state */
  .nav-hamburger.is-open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-hamburger.is-open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
  .nav-hamburger.is-open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* ─── DROPDOWN (desktop) ───────────────────────────────────────────────── */
  .nav-dropdown-wrap {
    position: relative;
  }

  /* Invisible bridge that fills the gap between the link and the dropdown,
     keeping the mouse inside .nav-dropdown-wrap while it travels down. */
  .nav-dropdown-wrap::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: 8px;
  }

  .nav-link--dropdown {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav-chevron {
    flex-shrink: 0;
    transition: transform 200ms ease;
    opacity: 0.6;
  }
  .nav-dropdown-wrap:hover .nav-chevron,
  .nav-dropdown-wrap:focus-within .nav-chevron {
    transform: rotate(180deg);
    opacity: 1;
  }

  .nav-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    background: var(--c-white-pure);
    border: 1px solid rgba(26, 20, 16, 0.10);
    border-radius: 12px;
    box-shadow: 0 8px 24px rgba(26, 20, 16, 0.12), 0 2px 6px rgba(26, 20, 16, 0.06);
    padding: 6px;
    min-width: 220px;
    z-index: 400;
    /* Hidden by default */
    opacity: 0;
    pointer-events: none;
    transform: translateX(-50%) translateY(-4px);
    transition: opacity 160ms ease, transform 160ms ease;
  }
  .nav-dropdown-wrap:hover .nav-dropdown,
  .nav-dropdown-wrap:focus-within .nav-dropdown {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .nav-dropdown-item {
    display: block;
    padding: 9px 14px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 400;
    font-family: var(--font-sans);
    color: var(--c-black);
    text-decoration: none;
    transition: background 110ms, color 110ms;
    white-space: nowrap;
  }
  .nav-dropdown-item:hover {
    background: rgba(139, 92, 246, 0.10);
    color: var(--c-violeta);
  }
  .nav-dropdown-item--active {
    background: var(--c-violeta);
    color: #fff;
  }
  .nav-dropdown-item--active:hover {
    background: var(--c-violeta);
    color: #fff;
    opacity: 0.88;
  }

  /* ─── MOBILE DRAWER ────────────────────────────────────────────────────── */
  .nav-drawer {
    position: fixed;
    top: 64px;
    left: 0;
    right: 0;
    z-index: 199;
    background: var(--c-white);
    border-bottom: 1px solid rgba(26, 20, 16, 0.10);
    transform: translateY(-110%);
    transition: transform 260ms cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }
  .nav-drawer.is-open {
    transform: translateY(0);
    pointer-events: auto;
  }
  .nav-drawer-inner {
    display: flex;
    flex-direction: column;
    padding: 16px 24px 24px;
    gap: 4px;
  }
  .nav-drawer-link {
    font-size: 17px;
    font-weight: 400;
    letter-spacing: -0.2px;
    padding: 12px 16px;
    border-radius: 10px;
    color: var(--c-black);
    text-decoration: none;
    font-family: var(--font-sans);
    transition: background 120ms;
  }
  .nav-drawer-link:hover { background: var(--c-glass-dark); }
  .nav-drawer-link[data-color="orange"]:hover { background: rgba(96, 157, 146, 0.12); color: var(--c-aguamarina); }
  .nav-drawer-link[data-color="rosado"]:hover   { background: rgba(230, 34, 79, 0.12);  color: var(--c-rosado); }
  .nav-drawer-link[data-color="cobalto"]:hover { background: rgba(59, 107, 220, 0.12); color: var(--c-cobalto); }
  .nav-drawer-link[data-color="aguamarina"]:hover   { background: rgba(226, 97, 29, 0.12);  color: var(--c-orange); }
  .nav-drawer-link[data-color="violeta"]:hover { background: rgba(139, 92, 246, 0.12); color: var(--c-violeta); }

  .nav-drawer-link.active { color: #fff; }
  .nav-drawer-link.active-orange { background: var(--c-aguamarina); }
  .nav-drawer-link.active-rosado   { background: var(--c-rosado); }
  .nav-drawer-link.active-cobalto { background: var(--c-cobalto); }
  .nav-drawer-link.active-aguamarina   { background: var(--c-orange); }
  .nav-drawer-link.active-violeta { background: var(--c-violeta); }

  /* Sub-links in drawer (under Servicios) */
  .nav-drawer-sublink {
    display: block;
    font-size: 14px;
    font-weight: 400;
    padding: 8px 16px 8px 32px;
    border-radius: 8px;
    color: rgba(26, 20, 16, 0.60);
    text-decoration: none;
    font-family: var(--font-sans);
    transition: background 110ms, color 110ms;
  }
  .nav-drawer-sublink::before {
    content: '↳ ';
    font-size: 11px;
    opacity: 0.5;
  }
  .nav-drawer-sublink:hover {
    background: rgba(139, 92, 246, 0.10);
    color: var(--c-violeta);
  }
  .nav-drawer-sublink--active {
    color: var(--c-violeta);
    font-weight: 500;
  }

  .nav-drawer-cta {
    margin-top: 8px;
    text-align: center;
    border-radius: 50px !important;
    margin-left: 0;
  }

  /* ─── OVERLAY ──────────────────────────────────────────────────────────── */
  .nav-overlay {
    display: none;
    position: fixed;
    inset: 0;
    top: 64px;
    z-index: 198;
    background: rgba(26, 20, 16, 0.35);
    opacity: 0;
    transition: opacity 260ms ease;
  }
  .nav-overlay.is-open {
    display: block;
    opacity: 1;
  }

  /* ─── LANGUAGE SWITCHER ────────────────────────────────────────────────── */
  .nav-lang {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.6px;
    font-weight: 600;
    color: var(--c-black);
    text-decoration: none;
    border: 1.5px solid rgba(26, 20, 16, 0.22);
    border-radius: 20px;
    padding: 5px 12px;
    margin-left: 8px;
    transition: background 130ms, color 130ms, border-color 130ms;
    flex-shrink: 0;
  }
  .nav-lang:hover {
    background: var(--c-black);
    border-color: var(--c-black);
    color: #fff;
  }

  .nav-drawer-lang {
    display: block;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: rgba(26, 20, 16, 0.6);
    text-decoration: none;
    padding: 12px 16px;
    border-radius: 10px;
    margin-top: 4px;
    transition: background 120ms, color 120ms;
  }
  .nav-drawer-lang:hover { background: var(--c-glass-dark); color: var(--c-black); }

  @media (max-width: 560px) {
    .nav-lang { display: none; }
  }

  /* ─── DONATE CIRCLE BUTTON ─────────────────────────────────────────────── */
  .nav-donar-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--c-aguamarina);
    color: #fff;
    font-size: 16px;
    font-weight: 600;
    font-family: var(--font-sans);
    text-decoration: none;
    flex-shrink: 0;
    transition: opacity 150ms;
  }
  .nav-donar-btn:hover { opacity: 0.85; }

  /* ─── SHOW HAMBURGER ON MOBILE ─────────────────────────────────────────── */
  @media (max-width: 560px) {
    .nav-hamburger { display: flex; margin-left: 0; }
    .nav-donar-btn { display: flex; margin-left: auto; margin-right: 8px; }
    .nav-cta { display: none; }
  }
</style>

<script>
  const hamburger = document.getElementById('nav-hamburger')!;
  const drawer    = document.getElementById('nav-drawer')!;
  const overlay   = document.getElementById('nav-overlay')!;

  function openMenu() {
    hamburger.classList.add('is-open');
    hamburger.setAttribute('aria-expanded', 'true');
    hamburger.setAttribute('aria-label', hamburger.dataset.labelClose ?? 'Cerrar menú');
    drawer.classList.add('is-open');
    drawer.setAttribute('aria-hidden', 'false');
    overlay.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    hamburger.classList.remove('is-open');
    hamburger.setAttribute('aria-expanded', 'false');
    hamburger.setAttribute('aria-label', hamburger.dataset.labelOpen ?? 'Abrir menú');
    drawer.classList.remove('is-open');
    drawer.setAttribute('aria-hidden', 'true');
    overlay.classList.remove('is-open');
    document.body.style.overflow = '';
  }

  hamburger.addEventListener('click', () => {
    hamburger.classList.contains('is-open') ? closeMenu() : openMenu();
  });

  overlay.addEventListener('click', closeMenu);

  // Close on nav link click (SPA-style navigation)
  drawer.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', closeMenu);
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });
</script>
