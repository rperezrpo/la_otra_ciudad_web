---
import SiteNav from './SiteNav.astro';
import SiteFooter from './SiteFooter.astro';
import { pageLang, alternatePath, ES_ONLY_PREFIXES } from '../../i18n/ui';
import '../../styles/global.css';

type PageColor = 'orange' | 'aguamarina' | 'cobalto' | 'rosado' | 'violeta';

const PAGE_COLORS: Record<PageColor, { accent: string; dark: string; gradient: string }> = {
  orange: { accent: 'var(--c-orange)', dark: 'var(--c-orange-dark)', gradient: 'var(--c-grad-orange)' },
  aguamarina:   { accent: 'var(--c-aguamarina)',   dark: 'var(--c-aguamarina-dark)',   gradient: 'var(--c-grad-aguamarina)'   },
  cobalto: { accent: 'var(--c-cobalto)', dark: 'var(--c-cobalto-dark)', gradient: 'var(--c-grad-cobalto)' },
  rosado:   { accent: 'var(--c-rosado)',   dark: 'var(--c-rosado-dark)',   gradient: 'var(--c-grad-rosado)'   },
  violeta: { accent: 'var(--c-violeta)', dark: 'var(--c-violeta-dark)', gradient: 'var(--c-grad-violeta)' },
};

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonLd?: object;
  pageColor?: PageColor;
}

const {
  title,
  description = 'Corporación La Otra Ciudad. Co-creando ciudades más justas, sostenibles y saludables en Medellín, Colombia.',
  ogImage = '/images/og-default.jpg',
  ogType = 'website',
  jsonLd,
  pageColor,
} = Astro.props;

const palette = pageColor ? PAGE_COLORS[pageColor] : null;
const pageStyle = palette
  ? `--page-accent: ${palette.accent}; --page-accent-dark: ${palette.dark}; --page-accent-gradient: ${palette.gradient};`
  : undefined;

const lang = pageLang(Astro.currentLocale);
const pathname = Astro.url.pathname;

const siteUrl = 'https://laotraciudad.org';
const canonicalUrl = new URL(pathname, siteUrl).href;
const ogImageAbsolute = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
const fullTitle = `${title} · La Otra Ciudad`;

// hreflang alternates: same slug in both languages, /en prefix for English.
// Editor-only routes have no English counterpart, so they get no alternates.
const esOnly = ES_ONLY_PREFIXES.some((p) => pathname.startsWith(p));
const esPath = lang === 'es' ? pathname : alternatePath(pathname, 'en');
const enPath = lang === 'en' ? pathname : alternatePath(pathname, 'es');
const esUrl = new URL(esPath, siteUrl).href;
const enUrl = new URL(enPath, siteUrl).href;
---

<!DOCTYPE html>
<html lang={lang} style={pageStyle}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {!esOnly && (
      <>
        <link rel="alternate" hreflang="es" href={esUrl} />
        <link rel="alternate" hreflang="en" href={enUrl} />
        <link rel="alternate" hreflang="x-default" href={esUrl} />
      </>
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{fullTitle}</title>

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="La Otra Ciudad" />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_CO'} />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <SiteNav />
    <main>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
