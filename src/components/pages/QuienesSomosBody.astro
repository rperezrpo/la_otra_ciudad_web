---
import BaseLayout from '../layout/BaseLayout.astro';
import PersonCard from '../PersonCard.astro';
import PageHero from '../layout/PageHero.astro';
import { getPeople } from '../../lib/sanity';
import type { Lang } from '../../i18n/ui';
import { quienesSomosContent } from '../../i18n/content/quienes-somos';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = quienesSomosContent[lang];

const peopleData = await getPeople();

// Only show people who have a photo — those without one are silently skipped
const activePeople = peopleData.filter((p) => p.photo && p.state === 'active');
const pastPeople = peopleData.filter((p) => p.state !== 'active');

const VALUE_COLORS = ['var(--c-aguamarina)', 'var(--c-rosado)', 'var(--c-violeta)', 'var(--c-orange)'];

// EDIT: update the allies list as partnerships change
// logo: path relative to /public — null = text-only tile
const aliados = [
  { name: 'Fundación Mi Sangre',  logo: '/images/allies/mi-sangre.png'          },
  { name: 'S2Cities',             logo: '/images/allies/s2cities.png'            },
  { name: 'Everyday Homeless',    logo: '/images/allies/everyday-homeless.png'   },
  { name: 'UCL Bartlett (DPU)',   logo: '/images/allies/dpu.jpg'                 },
  { name: 'Urbam–EAFIT',          logo: '/images/allies/urbam.jpg'               },
  { name: 'Somos x Naturaleza',   logo: '/images/allies/somos-x-naturaleza.png'  },
  { name: 'ETH Zurich',           logo: '/images/allies/eth-zurich.jpg'          },
  { name: 'Proyecto NN',          logo: '/images/allies/proyecto-nn.jpg'         },
  { name: 'intuyLab',             logo: '/images/allies/intuylab.jpg'            },
  { name: 'Alcaldía de Medellín', logo: '/images/allies/alcaldia-medellin.jpg'   },
  { name: 'Alcaldía de Envigado', logo: '/images/allies/alcaldia-envigado.png'   },
  { name: 'UMI Fund',             logo: null                                      },
  { name: 'Social Change Nest',   logo: null                                      },
  { name: 'Parque Explora',       logo: null                                      },
  { name: 'Low Carbon City',      logo: null                                      },
];
---

<BaseLayout
  title={c.metaTitle}
  description={c.metaDescription}
  pageColor="aguamarina"
>

  <!-- ─── PAGE HERO ─────────────────────────────────────────────────── -->
  <!-- EDIT: drop a photo into /public/images/banners/quienes-somos.jpg to activate the image background -->
  <PageHero eyebrow={c.heroEyebrow} image="/images/banners/quienes-somos.jpg">
    <h1 class="page-hero-title">{c.heroTitle}</h1>
    <p class="page-hero-sub">{c.heroSub}</p>
  </PageHero>

  <!-- ─── HISTORY ───────────────────────────────────────────────────── -->
  <div class="section">
    <div class="two-col">
      <div>
        <span class="eyebrow">{c.historiaEyebrow}</span>
        <h2 class="section-title" style="font-size: clamp(28px, 3vw, 42px);">{c.historiaTitle}</h2>
        <p class="section-body">
          {c.historiaP1}
        </p>
        <p class="section-body" style="margin-top: 16px;">
          {c.historiaP2}
        </p>
      </div>
      <div>
        <img
          src="/images/groupal/recorridos_de_ciudad.jpeg"
          alt={c.historiaImgAlt}
          style="width: 100%; height: 420px; object-fit: cover; border-radius: 8px; display: block;"
        />
        <a href="#nuestro-equipo" class="btn-outline" style="display: inline-block; margin-top: 16px;">
          {c.historiaBtnEquipo}
        </a>
      </div>
    </div>
  </div>

  <!-- ─── VALUES ────────────────────────────────────────────────────── -->
  <div id="valores" class="section-full" style="background: linear-gradient(135deg, #e2611d 0%, #3b6bdc 100%); padding: 80px 48px;">
    <div style="max-width: 1200px; margin: 0 auto;">
      <span class="eyebrow-light">{c.valoresEyebrow}</span>
      <h2 class="section-title" style="color: #fff; max-width: none;">{c.valoresTitle}</h2>
      <div class="card-grid-4" style="margin-top: 40px;">
        {c.valores.map((v, i) => (
          <div style={`background: ${VALUE_COLORS[i % VALUE_COLORS.length]}; border-radius: 8px; padding: 36px 32px;`}>
            <h3 style="font-family: var(--font-sans); font-size: 22px; font-weight: 600; letter-spacing: -0.3px; color: #fff; margin-bottom: 12px;">{v.title}</h3>
            <p style="font-size: 15px; font-weight: 300; line-height: 1.6; color: rgba(255,255,255,0.82);">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- ─── TEAM ──────────────────────────────────────────────────────── -->
  <div id="nuestro-equipo" class="section">
    <h2 class="section-title">{c.equipoTitle}</h2>

    <div class="team-grid" style="margin-top: 40px;">
      {activePeople.map((person) => (
        <PersonCard
          name={person.name}
          role={person.role}
          photo={person.photo}
          bio={person.bio}
          links={person.links}
          slug={person.slug}
          hasLongBio={person.hasLongBio}
        />
      ))}
    </div>

    {pastPeople.length > 0 && (
      <details class="past-team">
        <summary class="btn-outline past-team-toggle">
          {c.equipoPasado}
        </summary>
        <div class="past-team-panel">
          <ul class="past-team-list">
            {pastPeople.map((person) => (
              <li>{person.name}</li>
            ))}
          </ul>
        </div>
      </details>
    )}
  </div>

  <!-- ─── ALLIES ────────────────────────────────────────────────────── -->
  <div class="section-full" style="background: linear-gradient(135deg, #e2611d 0%, #3b6bdc 100%); padding: 64px 48px;">
    <div style="max-width: 1200px; margin: 0 auto;">
      <span class="eyebrow-light">{c.aliadosEyebrow}</span>
      <!-- EDIT: update aliados array above as alliances change -->
      <div style="display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px;">
        {aliados.map(({ name, logo }) => (
          <div style="background: #fff; border-radius: 8px; padding: 16px 24px; display: flex; align-items: center; justify-content: center; height: 80px; flex: 0 0 auto; min-width: 140px; max-width: 200px;">
            {logo ? (
              <img
                src={logo}
                alt={name}
                title={name}
                style="max-height: 46px; max-width: 160px; width: auto; object-fit: contain; display: block;"
              />
            ) : (
              <span style="font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.5px; text-transform: uppercase; color: var(--fg2); text-align: center; line-height: 1.4;">{name}</span>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>


</BaseLayout>

<style>
  .past-team {
    margin-top: 40px;
  }

  .past-team-toggle {
    list-style: none;
    user-select: none;
  }

  .past-team-toggle::-webkit-details-marker {
    display: none;
  }

  .past-team-toggle::after {
    content: '+';
    font-size: 18px;
    line-height: 1;
    transition: transform 150ms;
  }

  .past-team[open] .past-team-toggle::after {
    content: '–';
  }

  .past-team-panel {
    margin-top: 20px;
    background: var(--c-white-pure);
    border-radius: 8px;
    box-shadow: var(--shadow-sm);
    padding: 28px 32px;
  }

  .past-team-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px 24px;
    margin: 0;
    padding: 0;
  }

  .past-team-list li {
    font-size: 15px;
    font-weight: 300;
    color: var(--fg1);
  }

  @media (max-width: 768px) {
    .past-team-list { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 560px) {
    .past-team-list { grid-template-columns: 1fr; }
  }
</style>
