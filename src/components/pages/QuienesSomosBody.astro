---
import BaseLayout from '../layout/BaseLayout.astro';
import PersonCard from '../PersonCard.astro';
import PageHero from '../layout/PageHero.astro';
import { getPeople } from '../../lib/sanity';
import { localizePath, type Lang } from '../../i18n/ui';
import { quienesSomosContent } from '../../i18n/content/quienes-somos';
import { ALIADOS, alturaLogo } from '../../data/aliados';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = quienesSomosContent[lang];

const peopleData = await getPeople();

// Only show people who have a photo — those without one are silently skipped
const activePeople = peopleData.filter((p) => p.photo && p.state === 'active');
const pastPeople = peopleData.filter((p) => p.state !== 'active');

const VALUE_COLORS = ['var(--c-aguamarina)', 'var(--c-rosado)', 'var(--c-violeta)', 'var(--c-orange)'];

---

<BaseLayout
  title={c.metaTitle}
  description={c.metaDescription}
  pageColor="aguamarina"
>

  <!-- ─── PAGE HERO ─────────────────────────────────────────────────── -->
  <!-- EDIT: drop a photo into /public/images/banners/quienes-somos.jpg to activate the image background -->
  <PageHero image="/images/banners/quienes-somos.jpg">
    <h1 class="page-hero-title">{c.heroTitle}</h1>
    <p class="page-hero-sub">{c.heroSub}</p>
  </PageHero>

  <!-- ─── HISTORY ───────────────────────────────────────────────────── -->
  <div class="section">
    <div class="two-col">
      <div>
        <span class="eyebrow">{c.historiaEyebrow}</span>
        <h2 class="section-title" style="font-size: clamp(28px, 3vw, 42px);">{c.historiaTitle}</h2>
        <p class="section-body">
          {c.historiaP1}
        </p>
        <p class="section-body" style="margin-top: 16px;">
          {c.historiaP2}
        </p>
      </div>
      <div>
        <img
          src="/images/groupal/recorridos_de_ciudad.jpeg"
          alt={c.historiaImgAlt}
          style="width: 100%; height: 420px; object-fit: cover; border-radius: 8px; display: block;"
        />
        <div class="historia-actions">
          <a href="#nuestro-equipo" class="btn-outline">
            {c.historiaBtnEquipo}
          </a>
          <a href={localizePath(lang, '/sustainability-reports')} class="btn-outline">
            {c.historiaBtnInforme}
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- ─── VALUES ────────────────────────────────────────────────────── -->
  <div id="valores" class="section-full" style="background: linear-gradient(135deg, #e2611d 0%, #3b6bdc 100%); padding: 80px 48px;">
    <div style="max-width: 1200px; margin: 0 auto;">
      <span class="eyebrow-light">{c.misionEyebrow}</span>
      <p style="font-family: var(--font-display); font-variation-settings: var(--font-display-axes); font-size: clamp(28px, 3.6vw, 46px); font-weight: var(--font-display-weight); line-height: 1.15; letter-spacing: -1px; color: #fff; max-width: 900px; margin: 0 0 64px;">
        {c.misionText}
      </p>
      <h2 class="section-title" style="color: #fff; max-width: none;">{c.valoresTitle}</h2>
      <div class="card-grid-4" style="margin-top: 40px;">
        {c.valores.map((v, i) => (
          <div style={`background: ${VALUE_COLORS[i % VALUE_COLORS.length]}; border-radius: 8px; padding: 36px 32px;`}>
            <h3 style="font-family: var(--font-sans); font-size: 22px; font-weight: 600; letter-spacing: -0.3px; color: #fff; margin-bottom: 12px;">{v.title}</h3>
            <p style="font-size: 15px; font-weight: 300; line-height: 1.6; color: rgba(255,255,255,0.82);">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- ─── TEAM ──────────────────────────────────────────────────────── -->
  <div id="nuestro-equipo" class="section">
    <h2 class="section-title">{c.equipoTitle}</h2>

    <div class="team-grid" style="margin-top: 40px;">
      {activePeople.map((person) => (
        <PersonCard
          name={person.name}
          role={person.role}
          photo={person.photo}
          bio={person.bio}
          links={person.links}
          slug={person.slug}
          hasLongBio={person.hasLongBio}
        />
      ))}
    </div>

    {pastPeople.length > 0 && (
      <details class="past-team">
        <summary class="btn-outline past-team-toggle">
          {c.equipoPasado}
        </summary>
        <div class="past-team-panel">
          <ul class="past-team-list">
            {pastPeople.map((person) => (
              <li>{person.name}</li>
            ))}
          </ul>
        </div>
      </details>
    )}
  </div>

  <!-- ─── ALLIES ────────────────────────────────────────────────────── -->
  <div class="section-full allies-section" style="background: linear-gradient(135deg, #e2611d 0%, #3b6bdc 100%); padding: 64px 48px;">
    <div style="max-width: 1200px; margin: 0 auto;">
      <span class="eyebrow-light">{c.aliadosEyebrow}</span>
      <!-- EDIT: the list lives in src/data/aliados.ts -->
      <ul class="allies-grid">
        {ALIADOS.map(({ name, logo, ratio }) => (
          <li class="ally-tile" title={name}>
            <img
              src={logo}
              alt={name}
              loading="lazy"
              decoding="async"
              class="ally-logo"
              style={`--h: ${alturaLogo(ratio)}px; --r: ${ratio};`}
            />
          </li>
        ))}
      </ul>
    </div>
  </div>


</BaseLayout>

<style>
  .historia-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-top: 16px;
  }
  /* Keeps the report button flush with the image's right edge, even when wrapped */
  .historia-actions > :last-child { margin-left: auto; }
  .past-team {
    margin-top: 40px;
  }

  .past-team-toggle {
    list-style: none;
    user-select: none;
  }

  .past-team-toggle::-webkit-details-marker {
    display: none;
  }

  .past-team-toggle::after {
    content: '+';
    font-size: 18px;
    line-height: 1;
    transition: transform 150ms;
  }

  .past-team[open] .past-team-toggle::after {
    content: '–';
  }

  .past-team-panel {
    margin-top: 20px;
    background: var(--c-white-pure);
    border-radius: 8px;
    box-shadow: var(--shadow-sm);
    padding: 28px 32px;
  }

  .past-team-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px 24px;
    margin: 0;
    padding: 0;
  }

  .past-team-list li {
    font-size: 15px;
    font-weight: 300;
    color: var(--fg1);
  }

  @media (max-width: 768px) {
    .past-team-list { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 560px) {
    .past-team-list { grid-template-columns: 1fr; }
  }

  /* ─── ALLIES GRID ─────────────────────────────────────────────────────── */
  /* Every tile has the same height; its width follows the logo it holds. */
  .allies-grid {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .ally-tile {
    flex: 0 0 auto;
    background: #fff;
    border-radius: 8px;
    height: 92px;
    padding: 0 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 160ms ease, box-shadow 160ms ease;
  }
  .ally-tile:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(26, 20, 16, 0.18);
  }

  /* Height comes from the logo's aspect ratio (see alturaLogo) so every logo
     carries about the same visual weight; width is set from the same ratio so
     the tile has its final size before the lazy-loaded image arrives. */
  .ally-logo {
    display: block;
    height: var(--h);
    width: calc(var(--h) * var(--r));
    object-fit: contain;
    border-radius: 3px;
  }

  @media (max-width: 560px) {
    .allies-section { padding: 48px 20px !important; }
    .allies-grid { gap: 8px; }
    .ally-tile {
      height: 72px;
      padding: 0 16px;
    }
    .ally-logo {
      height: calc(var(--h) * 0.72);
      width: calc(var(--h) * 0.72 * var(--r));
    }
  }
</style>
