---
// Cuerpo compartido por las 3 subpáginas de servicios (una por categoría).
import BaseLayout from '../layout/BaseLayout.astro';
import PageHero from '../layout/PageHero.astro';
import ProjectCard from '../ProjectCard.astro';
// Bloques opcionales. El componente compartido decide SI un bloque existe (guard
// por dato, nunca por servicio); cada componente de sección decide CÓMO se ve.
import ComparisonTable from '../sections/ComparisonTable.astro';
import OfferGrid from '../sections/OfferGrid.astro';
import PrincipleCards from '../sections/PrincipleCards.astro';
import StatsStrip from '../sections/StatsStrip.astro';
import ExpertiseBand from '../sections/ExpertiseBand.astro';
import PullQuote from '../sections/PullQuote.astro';
import { getProjectsByCategory } from '../../lib/sanity';
import { localizePath, type Lang } from '../../i18n/ui';
import { CATEGORY_META, type CategoryKey } from '../../i18n/categories';
import { serviciosDetalleContent } from '../../i18n/content/servicios-detalle';

interface Props {
  lang: Lang;
  service: CategoryKey;
}

const { lang, service } = Astro.props;
const c = serviciosDetalleContent[lang][service];
const l = (path: string) => localizePath(lang, path);

const SERVICE_META: Record<CategoryKey, { image: string; pageColor: 'aguamarina' | 'cobalto' | 'violeta'; ctaBg: string }> = {
  'paisajes-regenerativos':     { image: '/images/banners/paisajes_regenerativos.jpg',     pageColor: 'aguamarina', ctaBg: 'var(--c-aguamarina)' },
  'espacio-publico':            { image: '/images/banners/espacios_publicos.jpg',          pageColor: 'cobalto',    ctaBg: 'var(--c-cobalto)' },
  'acompanamiento-comunitario': { image: '/images/banners/acompanamiento_comunitario.jpg', pageColor: 'violeta',    ctaBg: 'var(--page-accent)' },
};

const meta = SERVICE_META[service];
const title = CATEGORY_META[service][lang];

const projects = await getProjectsByCategory(service, lang);
---

<BaseLayout
  title={title}
  description={c.metaDescription}
  pageColor={meta.pageColor}
>
  <PageHero type="banner" eyebrow={c.heroEyebrow} image={meta.image}>
    <h1 class="page-hero-title">{title}</h1>
    <p class="page-hero-sub">
      {c.heroSub}
    </p>
    {c.heroBtn && (
      <a href={l(c.heroBtn.href)} class="btn-hero-primary" style="margin-top: 28px;">
        {c.heroBtn.label}
      </a>
    )}
  </PageHero>

  <!-- ─── EL PROBLEMA (opcional) ────────────────────────────────────────── -->
  {c.problema && <ComparisonTable {...c.problema} />}

  <!-- ─── DESCRIPCIÓN ───────────────────────────────────────────────────── -->
  <div class="section">
    <div class="two-col">
      <div>
        <span class="eyebrow">{c.queHacemosEyebrow}</span>
        <h2 class="section-title">{c.queHacemosTitle}</h2>
      </div>
      <div>
        <p class="section-body" style="margin-top: 0;">
          {c.p1}
        </p>
        <p class="section-body">
          {c.p2}
        </p>
      </div>
    </div>
  </div>

  <!-- ─── OFERTA / PARA QUIÉN (opcional) ─────────────────────────────────── -->
  {c.oferta && <OfferGrid {...c.oferta} />}

  <!-- ─── PRINCIPIOS (opcional) ──────────────────────────────────────────── -->
  {c.principios && (
    <PrincipleCards
      eyebrow={c.principios.eyebrow}
      title={c.principios.title}
      items={c.principios.items}
      link={c.principios.link && { label: c.principios.link.label, href: l(c.principios.link.href) }}
    />
  )}

  <!-- ─── PROYECTOS ──────────────────────────────────────────────────────── -->
  {projects.length > 0 && (
    <div class="section-full section-warm" style="padding: 64px 0 80px;">
      <div style="max-width: 1200px; margin: 0 auto; padding: 0 48px;">
        <span class="eyebrow">{c.experienciaEyebrow}</span>
        <h2 class="section-title" style="margin-bottom: 40px;">{c.experienciaTitle}</h2>
        <div class="card-grid-3">
          {projects.map(p => (
            <ProjectCard
              title={p.title}
              slug={p.slug}
              category={p.categoryLabel}
              summary={p.summary}
              heroImage={p.heroImage}
              status={p.status}
              year={p.year}
            />
          ))}
        </div>
        {c.cifras && <StatsStrip items={c.cifras} />}
      </div>
    </div>
  )}

  <!-- ─── EXPERTICIA (opcional) ──────────────────────────────────────────── -->
  {c.disciplinas && (
    <ExpertiseBand
      eyebrow={c.disciplinas.eyebrow}
      title={c.disciplinas.title}
      body={c.disciplinas.body}
      items={c.disciplinas.items}
      link={c.disciplinas.link && { label: c.disciplinas.link.label, href: l(c.disciplinas.link.href) }}
    />
  )}

  <!-- ─── MANIFIESTO (opcional) ──────────────────────────────────────────── -->
  {c.manifiesto && <PullQuote {...c.manifiesto} />}

  <!-- ─── CTA ────────────────────────────────────────────────────────────── -->
  <div class="section-full" style={`background: ${meta.ctaBg}; padding: 72px 48px; text-align: center;`}>
    <span style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.6px; text-transform: uppercase; color: rgba(255,255,255,0.6);">
      {c.ctaEyebrow}
    </span>
    <h2 style="font-family: var(--font-display); font-variation-settings: 'opsz' 144, 'SOFT' 30, 'WONK' 0; font-size: clamp(28px, 4vw, 48px); font-weight: 400; letter-spacing: -1px; line-height: 1.1; color: #fff; max-width: 560px; margin: 16px auto 24px;">
      {c.ctaTitle}
    </h2>
    {c.ctaText && (
      <p style="font-size: 17px; font-weight: 300; line-height: 1.6; letter-spacing: -0.1px; color: rgba(255,255,255,0.92); max-width: 600px; margin: 0 auto 28px;">
        {c.ctaText}
      </p>
    )}
    <a href={l('/contacto')} class="btn-hero-primary" style={`background: #fff; color: ${meta.ctaBg};`}>{c.ctaBtn}</a>
  </div>

</BaseLayout>
