---
import BaseLayout from '../layout/BaseLayout.astro';
import PageHero from '../layout/PageHero.astro';
import { localizePath, type Lang } from '../../i18n/ui';
import { metodologiaContent } from '../../i18n/content/metodologia';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = metodologiaContent[lang];
const l = (path: string) => localizePath(lang, path);

// Colors and icons per step (text lives in src/i18n/content/metodologia.ts)
const PASO_META = [
  {
    color: '#27ae60',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>`,
  },
  {
    color: '#3b6bdc',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>`,
  },
  {
    color: '#e2611d',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>`,
  },
  {
    color: '#8b5cf6',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  },
  {
    color: '#ef4444',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/><line x1="2" y1="20" x2="22" y2="20"/></svg>`,
  },
];

const pasos = c.pasos.map((paso, i) => ({ ...paso, ...PASO_META[i] }));

const ENFOQUE_COLORS = ['var(--c-rosado)', 'var(--c-orange)', 'var(--c-aguamarina)'];
---

<BaseLayout
  title={c.metaTitle}
  description={c.metaDescription}
  pageColor="cobalto"
>

  <!-- ─── PAGE HERO ─────────────────────────────────────────────────── -->
  <!-- EDIT: drop a photo into /public/images/banners/metodologia.jpg to activate the image background -->
  <PageHero eyebrow={c.heroEyebrow} image="/images/banners/metodologia.jpg">
    <h1 class="page-hero-title">{c.heroTitle}</h1>
    <p class="page-hero-sub">{c.heroSub}</p>
  </PageHero>

  <div class="section">

    <!-- ─── INTRO WITH QUOTE ────────────────────────────────────────── -->
    <div class="two-col" style="margin-bottom: 72px; align-items: start;">
      <div>
        <blockquote class="quote-block">
          {c.quote}
        </blockquote>
      </div>
      <div>
        <p class="section-body" style="margin-top: 0;">
          {c.introP1}
        </p>
        <p class="section-body" style="margin-top: 14px;">
          {c.introP2}
        </p>
      </div>
    </div>

    <!-- ─── FIVE STEPS ───────────────────────────────────────────────── -->
    <div class="steps-timeline">
      {pasos.map((paso) => (
        <div
          class="step-node"
          tabindex="0"
          data-title={paso.title}
          data-desc={paso.desc}
          data-color={paso.color}
        >
          <div class="step-circle" style={`--sc: ${paso.color}`}>
            <Fragment set:html={paso.icon} />
          </div>
          <div class="step-label">{paso.title}</div>
        </div>
      ))}
    </div>

    <!-- ─── SHARED DESCRIPTION PANEL ────────────────────────────────── -->
    <div class="steps-panel" id="steps-panel" data-placeholder={c.pasosPlaceholder}>
      <div class="steps-panel-inner" id="steps-panel-inner">
        <p class="steps-panel-placeholder">{c.pasosPlaceholder}</p>
      </div>
    </div>

  </div>

  <!-- ─── TRANSVERSAL APPROACHES ────────────────────────────────────── -->
  <div class="section-full section-dark-warm" style="padding: 80px 48px;">
    <div style="max-width: 1100px; margin: 0 auto;">
      <span class="eyebrow-light">{c.enfoquesEyebrow}</span>
      <h2 class="section-title-light" style="margin-top: 16px;">{c.enfoquesTitle}</h2>
      <div class="card-grid-3" style="margin-top: 40px;">
        {c.enfoques.map((e, i) => (
          <div style={`background: ${ENFOQUE_COLORS[i % ENFOQUE_COLORS.length]}; border-radius: 8px; padding: 28px 24px;`}>
            <div style="font-size: 17px; font-weight: 600; letter-spacing: -0.2px; color: #fff; margin-bottom: 10px;">{e.title}</div>
            <div style="font-size: 14px; font-weight: 300; line-height: 1.6; color: rgba(255,255,255,0.55);">{e.desc}</div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- ─── CONTACT CTA ───────────────────────────────────────────────── -->
  <div class="section" style="text-align: center;">
    <h2 class="section-title" style="margin: 0 auto;">{c.ctaTitle}</h2>
    <p style="font-size: 17px; font-weight: 300; color: var(--fg2); max-width: 440px; margin: 16px auto 28px; line-height: 1.6;">
      {c.ctaText}
    </p>
    <a href={l('/contacto')} class="btn-accent">{c.ctaBtn}</a>
  </div>

</BaseLayout>

<style>
  /* ── Timeline container ── */
  .steps-timeline {
    display: flex;
    align-items: flex-start;
    position: relative;
    margin-top: 56px;
  }

  /* horizontal connecting line */
  .steps-timeline::before {
    content: '';
    position: absolute;
    top: 52px; /* half of circle height (104px) */
    left: 10%;
    right: 10%;
    height: 2px;
    background: linear-gradient(
      90deg,
      #27ae60 0%,
      #3b6bdc 28%,
      #e2611d 52%,
      #8b5cf6 76%,
      #ef4444 100%
    );
    z-index: 0;
    opacity: 0.35;
  }

  /* ── Each step node ── */
  .step-node {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    z-index: 1;
    outline: none;
    cursor: pointer;
  }

  /* ── Circle ── */
  .step-circle {
    width: 104px;
    height: 104px;
    border-radius: 50%;
    background: var(--sc);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 16px rgba(0, 0, 0, 0.12);
    position: relative;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  /* outer ring */
  .step-circle::after {
    content: '';
    position: absolute;
    top: -10px;
    right: -10px;
    bottom: -10px;
    left: -10px;
    border-radius: 50%;
    border: 2px solid var(--sc);
    opacity: 0.28;
    transform: scale(1);
    transition: opacity 0.3s ease, transform 0.3s ease;
    pointer-events: none;
  }

  .step-node:hover .step-circle,
  .step-node:focus-visible .step-circle,
  .step-node.active .step-circle {
    transform: scale(1.08);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.18);
  }

  .step-node:hover .step-circle::after,
  .step-node:focus-visible .step-circle::after,
  .step-node.active .step-circle::after {
    opacity: 0.6;
    transform: scale(1.12);
  }

  .step-circle :global(svg) {
    width: 44px;
    height: 44px;
    color: #fff;
    stroke: #fff;
  }

  /* ── Label ── */
  .step-label {
    margin-top: 18px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.1px;
    text-align: center;
    color: var(--c-black);
    max-width: 120px;
    line-height: 1.35;
    transition: color 0.2s ease;
  }

  .step-node:hover .step-label,
  .step-node:focus-visible .step-label,
  .step-node.active .step-label {
    color: var(--sc);
  }

  /* ── Shared description panel ── */
  .steps-panel {
    margin-top: 28px;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 2px 20px rgba(0, 0, 0, 0.06);
    border: 1px solid rgba(26, 20, 16, 0.07);
    border-left-width: 4px;
    border-left-color: var(--panel-color, rgba(26, 20, 16, 0.10));
    min-height: 96px;
    display: flex;
    align-items: center;
    transition: border-left-color 0.3s ease;
  }

  .steps-panel-inner {
    padding: 22px 28px;
    width: 100%;
    transition: opacity 0.15s ease;
  }

  .steps-panel-inner.fading {
    opacity: 0;
  }

  .steps-panel-placeholder {
    margin: 0;
    font-size: 15px;
    font-style: italic;
    color: var(--fg2);
    opacity: 0.45;
    text-align: center;
  }

  .steps-panel-title {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.2px;
    color: var(--c-black);
    margin-bottom: 6px;
  }

  .steps-panel-desc {
    font-size: 14px;
    line-height: 1.65;
    color: var(--fg2);
    font-weight: 300;
    max-width: 780px;
  }

  /* ── Mobile: vertical stack ── */
  @media (max-width: 799px) {
    .steps-timeline {
      flex-direction: column;
      align-items: stretch;
      margin-top: 32px;
    }

    .steps-timeline::before {
      display: none;
    }

    .step-node {
      flex-direction: row;
      align-items: center;
      gap: 20px;
      padding: 16px 0;
      border-top: 1px solid rgba(26, 20, 16, 0.08);
    }

    .step-node:last-child {
      border-bottom: 1px solid rgba(26, 20, 16, 0.08);
    }

    .step-circle {
      width: 72px;
      height: 72px;
      flex-shrink: 0;
    }

    .step-circle::after {
      top: -7px;
      right: -7px;
      bottom: -7px;
      left: -7px;
    }

    .step-circle :global(svg) {
      width: 32px;
      height: 32px;
    }

    .step-label {
      margin-top: 0;
      text-align: left;
      max-width: none;
      font-size: 15px;
    }

    .steps-panel {
      margin-top: 20px;
    }
  }
</style>

<script>
  const nodes = document.querySelectorAll<HTMLElement>('.step-node');
  const panel = document.getElementById('steps-panel') as HTMLElement;
  const panelInner = document.getElementById('steps-panel-inner') as HTMLElement;
  const placeholderText = panel.dataset.placeholder ?? '';

  let activeNode: HTMLElement | null = null;
  let fadeTimeout: ReturnType<typeof setTimeout> | null = null;

  function fadePanel(newContent: string, color: string) {
    if (fadeTimeout) clearTimeout(fadeTimeout);
    panelInner.classList.add('fading');
    fadeTimeout = setTimeout(() => {
      panelInner.innerHTML = newContent;
      panel.style.setProperty('--panel-color', color);
      panelInner.classList.remove('fading');
      fadeTimeout = null;
    }, 150);
  }

  function showDefault() {
    const p = document.createElement('p');
    p.className = 'steps-panel-placeholder';
    p.textContent = placeholderText;
    fadePanel(p.outerHTML, 'rgba(26,20,16,0.10)');
  }

  function showStep(node: HTMLElement) {
    const title = node.dataset.title ?? '';
    const desc = node.dataset.desc ?? '';
    const color = node.dataset.color ?? '#000';
    fadePanel(
      `<div class="steps-panel-title">${title}</div><div class="steps-panel-desc">${desc}</div>`,
      color
    );
  }

  nodes.forEach(node => {
    // Desktop: hover shows step, leave returns to active or default
    node.addEventListener('mouseenter', () => {
      showStep(node);
    });

    node.addEventListener('mouseleave', () => {
      if (activeNode) {
        showStep(activeNode);
      } else {
        showDefault();
      }
    });

    // Click: toggle sticky active state
    node.addEventListener('click', (e) => {
      e.stopPropagation();
      const wasActive = activeNode === node;
      if (activeNode) activeNode.classList.remove('active');
      if (wasActive) {
        activeNode = null;
        showDefault();
      } else {
        node.classList.add('active');
        activeNode = node;
        showStep(node);
      }
    });

    // Keyboard navigation
    node.addEventListener('focus', () => {
      showStep(node);
    });

    node.addEventListener('blur', () => {
      setTimeout(() => {
        if (activeNode) {
          showStep(activeNode);
        } else {
          showDefault();
        }
      }, 100);
    });
  });

  // Click outside deactivates
  document.addEventListener('click', () => {
    if (activeNode) {
      activeNode.classList.remove('active');
      activeNode = null;
      showDefault();
    }
  });
</script>
