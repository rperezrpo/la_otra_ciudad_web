---
// ProjectCard — used on the home page and /proyectos listing.
// `category` is the already-localized label; `status` is the stable key
// ('activo'/'completado') and gets translated here.
import { Image } from 'astro:assets';
import { pageLang, localizePath } from '../i18n/ui';
import { statusLabel } from '../i18n/categories';

interface Props {
  title: string;
  slug: string;
  category: string;
  summary: string;
  heroImage: string;
  status: string;
  year: number;
}

const { title, slug, category, summary, heroImage, status, year } = Astro.props;

const lang = pageLang(Astro.currentLocale);
const isActive = status === 'activo';
---

<a href={localizePath(lang, `/proyectos/${slug}`)} class="card" style="display: flex; flex-direction: column; height: 100%; text-decoration: none; cursor: pointer;">
  <!-- Hero image -->
  {heroImage ? (
    <Image
      src={heroImage}
      alt={title}
      width={360}
      height={270}
      style="width: 100%; aspect-ratio: 4/3; object-fit: cover; display: block;"
    />
  ) : (
    <div class="img-placeholder" style="aspect-ratio: 4/3;">
      <span>{category}</span>
    </div>
  )}

  <div class="card-body" style="display: flex; flex-direction: column; flex: 1;">
    <!-- Tag + status row -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
      <div class="card-tag">{category}</div>
      <span
        class:list={['status-badge', { 'status-activo': isActive, 'status-completado': !isActive }]}
      >
        {statusLabel(status, lang)}
      </span>
    </div>

    <div class="card-title">{title}</div>
    <div class="card-desc" style="flex: 1;">{summary}</div>

    <div style="margin-top: 14px; font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.5px; color: var(--fg2);">
      {year}
    </div>
  </div>
</a>
