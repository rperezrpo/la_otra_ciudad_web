---
// PersonCard — used on /quienes-somos team grid
// SANITY: when Sanity is connected, this component receives props
//         from a Sanity "people" document instead of from people.json

interface Props {
  name: string;
  role: string;
  photo: string;
  bio?: string;
  linkedin?: string;
}

const { name, role, photo, bio, linkedin } = Astro.props;
---

<div class="person-card">

  <!-- Avatar -->
  <div class="person-avatar">
    <img src={photo} alt={name} class="person-photo" />
  </div>

  {bio && (
    <div class="person-bio-popup" aria-hidden="true">
      <div class="popup-header">
        <span class="popup-name">{name}</span>
        <span class="popup-role">{role}</span>
      </div>
      <p class="person-bio-text">{bio}</p>
      {linkedin && (
        <a
          href={linkedin}
          class="person-linkedin"
          target="_blank"
          rel="noopener noreferrer"
          title="LinkedIn"
          tabindex="-1"
        >
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
            <rect x="2" y="9" width="4" height="12"/>
            <circle cx="4" cy="4" r="2"/>
          </svg>
        </a>
      )}
    </div>
  )}

  <div class="person-name">{name}</div>
  <div class="person-role">{role}</div>
</div>

<style>
  /* Card establishes a stacking context so hover raises it above siblings */
  .person-card {
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 0;
  }

  .person-card:hover {
    z-index: 10;
  }

  /* ── Avatar ── */
  .person-avatar {
    position: relative;
    z-index: 1;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 8px;
    overflow: hidden;
    background: var(--bg2);
    margin-bottom: 14px;
  }

  .person-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 380ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .person-card:hover .person-photo {
    transform: scale(1.04);
  }

  /* ── Overlay bio popup — centered over the full card, slightly larger ── */
  .person-bio-popup {
    position: absolute;
    inset: -14px;              /* expands 14 px beyond all four edges of .person-card */
    z-index: 5;                /* above avatar and name/role labels */

    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    border: 1.5px solid rgba(255, 255, 255, 0.7);
    border-radius: 12px;
    padding: 18px 20px 16px;

    display: flex;
    flex-direction: column;

    box-shadow: 0 8px 36px -6px rgba(26, 20, 16, 0.18);

    /* Hidden state: slightly shrunk + invisible */
    opacity: 0;
    transform: scale(0.92);
    transition:
      opacity 180ms ease,
      transform 260ms cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }

  /* Revealed state */
  .person-card:hover .person-bio-popup {
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
  }

  /* ── Name + role inside popup ── */
  .popup-header {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-bottom: 10px;
    flex-shrink: 0;
  }

  .popup-name {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.2px;
    color: var(--c-black);
  }

  .popup-role {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--fg2);
  }

  /* ── Bio text — fills remaining space; JS shrinks font to fit ── */
  .person-bio-text {
    font-family: var(--font-sans);
    font-size: 12.5px;
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: -0.1px;
    color: var(--fg1);
    margin: 0;
    flex: 1;
    overflow: hidden;
  }

  /* ── LinkedIn circle icon ── */
  .person-linkedin {
    flex-shrink: 0;
    align-self: flex-end;
    margin-top: 8px;
    margin-right: -2px;
    margin-bottom: -2px;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: rgba(96, 157, 146, 0.1);
    border: 1.5px solid var(--c-teal);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--c-teal);
    text-decoration: none;
    transition: background 150ms, color 150ms;
  }

  .person-linkedin:hover {
    background: var(--c-teal);
    color: #fff;
  }

  /* ── Name + role below avatar (visible when not hovering) ── */
  .person-name {
    position: relative;
    z-index: 1;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.2px;
    color: var(--c-black);
    margin-bottom: 4px;
  }

  .person-role {
    position: relative;
    z-index: 1;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--fg2);
  }
</style>

<script>
  // Shrink bio font until text fits inside the popup
  function fitBioText() {
    document.querySelectorAll<HTMLElement>('.person-bio-popup').forEach((popup) => {
      const text = popup.querySelector<HTMLElement>('.person-bio-text');
      if (!text) return;
      let size = 12.5;
      text.style.fontSize = size + 'px';
      while (text.scrollHeight > text.clientHeight + 2 && size > 9) {
        size -= 0.5;
        text.style.fontSize = size + 'px';
      }
    });
  }

  const init = () => { fitBioText(); };
  document.fonts ? document.fonts.ready.then(init) : window.addEventListener('load', init);
  window.addEventListener('resize', fitBioText);
</script>
