---
import PageHero from './layout/PageHero.astro';
import PortableTextBody from './PortableTextBody.tsx';
import { pageLang, useTranslations, localizePath } from '../i18n/ui';
import { statusLabel } from '../i18n/categories';
import type { GalleryImage } from '../lib/sanity';

interface Props {
  title: string;
  /** Already-localized category label. */
  category: string;
  heroImage: string;
  description: any[];
  neighborhood: string;
  partners: string[];
  year: number;
  status: string;
  gallery: GalleryImage[];
}

const { title, category, heroImage, description, neighborhood, partners, year, status, gallery } = Astro.props;

const lang = pageLang(Astro.currentLocale);
const t = useTranslations(lang);
const l = (path: string) => localizePath(lang, path);

const isActive = status === 'activo';
---

<!-- Hero with image background, no eyebrow -->
<PageHero image={heroImage}>
  <a href={l('/proyectos')} class="hero-back">{t('project.volver')}</a>
  <h1 class="page-hero-title">{title}</h1>
  <div class="hero-meta">
    <span class:list={['status-badge', { 'status-activo': isActive, 'status-completado': !isActive }]}>
      {statusLabel(status, lang)}
    </span>
    <span class="meta-sep">·</span>
    <span class="meta-badge">{category}</span>
    <span class="meta-sep">·</span>
    <span class="meta-badge">{year}</span>
  </div>
</PageHero>

<!-- Two-column: description + stacked prop cards -->
<div class="section project-section">
  <div class="project-layout">

    <div class="project-body">
      <PortableTextBody value={description} />
    </div>

    <aside class="project-sidebar">

      {neighborhood && (
        <div class="prop-card prop-card--rosado">
          <div class="prop-label">{t('project.territorio')}</div>
          <div class="prop-value">{neighborhood}</div>
        </div>
      )}

      <div class="prop-card prop-card--cobalto">
        <div class="prop-label">{t('project.ano')}</div>
        <div class="prop-value">{year}</div>
      </div>

      {partners.length > 0 && (
        <div class="prop-card prop-card--orange">
          <div class="prop-label">{t('project.aliados')}</div>
          <ul class="prop-list">
            {partners.map((p) => <li class="prop-value">{p}</li>)}
          </ul>
        </div>
      )}


    </aside>

  </div>
</div>

<!-- Gallery — justified rows: each photo keeps its own aspect ratio (no
     cropping) and rows stretch to fill the width. Click opens PhotoSwipe. -->
{gallery.length > 0 && (
  <div class="section gallery-section">
    <span class="eyebrow">{t('project.galeria')}</span>
    <div class="gallery-rows" id="project-gallery">
      {gallery.map((g, i) => {
        const ratio = g.width / g.height;
        return (
          <a
            href={g.full}
            class="gallery-item"
            style={`--r:${ratio.toFixed(4)}`}
            data-pswp-width={g.width}
            data-pswp-height={g.height}
            aria-label={`${t('project.galeria')} ${i + 1}/${gallery.length}`}
          >
            <img src={g.src} alt="" width={g.width} height={g.height} loading="lazy" decoding="async" />
          </a>
        );
      })}
    </div>
  </div>
)}

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  // Thin chevron for prev/next. PhotoSwipe mirrors the "next" arrow with CSS,
  // so one shape serves both. The wider white stroke underneath is a halo
  // that keeps the dark line readable when it sits over a photo.
  const chevron =
    '<svg class="pswp__icn pswp-chevron" viewBox="0 0 60 60" width="60" height="60" aria-hidden="true">' +
    '<path class="pswp-chevron-halo" d="M35 16 L21 30 L35 44"/>' +
    '<path class="pswp-chevron-line" d="M35 16 L21 30 L35 44"/>' +
    '</svg>';

  if (document.getElementById('project-gallery')) {
    const lightbox = new PhotoSwipeLightbox({
      arrowPrevSVG: chevron,
      arrowNextSVG: chevron,
      gallery: '#project-gallery',
      children: 'a',
      pswpModule: () => import('photoswipe'),
      bgOpacity: 1,
      showHideAnimationType: 'zoom',
    });

    // Glass backdrop: a blurred copy of the current photo under a whitish
    // veil. Each slide change stacks a new layer and fades it in over the
    // previous one, so the colour shifts smoothly instead of jumping.
    let shown = '';
    const updateGlass = () => {
      const pswp = lightbox.pswp;
      const bg = pswp?.element?.querySelector<HTMLElement>('.pswp__bg');
      const data = pswp?.currSlide?.data;
      const url = data?.msrc || data?.src;
      if (!bg || !url || url === shown) return;
      shown = url;

      const layer = document.createElement('div');
      layer.className = 'pswp-glass';
      layer.style.backgroundImage = `url("${url}")`;
      bg.appendChild(layer);
      requestAnimationFrame(() => layer.classList.add('is-visible'));
      // Drop the layers underneath once the fade (450ms) is done.
      setTimeout(() => {
        bg.querySelectorAll('.pswp-glass').forEach((el) => { if (el !== layer) el.remove(); });
      }, 500);
    };
    lightbox.on('firstUpdate', updateGlass);
    lightbox.on('change', updateGlass);
    lightbox.on('destroy', () => { shown = ''; });

    lightbox.init();
  }
</script>

<!-- The lightbox is mounted on <body>, outside this component's scoped CSS. -->
<style is:global>
  /* Doubled class: photoswipe/style.css loads after this and sets the same
     variables on .pswp, so we need the extra specificity to win. */
  .pswp.pswp {
    /* Dark symbols with a light halo: readable over the whitish glass and
       over any part of a photo the controls happen to overlap. */
    --pswp-icon-color: var(--c-black);
    --pswp-icon-color-secondary: rgba(255, 255, 255, 0.9);
    --pswp-icon-stroke-color: rgba(255, 255, 255, 0.9);
    --pswp-icon-stroke-width: 2px;
    --pswp-placeholder-bg: rgba(255, 255, 255, 0.35);
    --pswp-preloader-color: rgba(26, 20, 16, 0.2);
    --pswp-preloader-color-secondary: var(--c-black);
    --pswp-error-text-color: var(--c-black);
  }

  .pswp__bg {
    background: var(--c-white);
    overflow: hidden;
  }

  /* Whitish veil above the blurred photo layers. */
  .pswp__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(247, 243, 238, 0.55);
  }

  .pswp-glass {
    position: absolute;
    inset: -10%;
    background-position: center;
    background-size: cover;
    filter: blur(32px) saturate(1.4);
    opacity: 0;
    transition: opacity 450ms ease;
  }

  .pswp-glass.is-visible { opacity: 1; }

  .pswp-chevron path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pswp-chevron-halo {
    stroke: rgba(255, 255, 255, 0.75);
    stroke-width: 4;
  }
  .pswp-chevron-line {
    stroke: var(--c-black);
    stroke-width: 1.5;
  }
  .pswp__button--arrow .pswp-chevron { transition: transform 200ms ease; }
  .pswp__button--arrow--prev:hover .pswp-chevron { transform: translateX(-3px); }
  .pswp__button--arrow--next:hover .pswp-chevron { transform: scale(-1, 1) translateX(-3px); }

  .pswp__counter {
    text-shadow: 0 0 6px rgba(255, 255, 255, 0.9);
    font-weight: 500;
  }

  @media (prefers-reduced-motion: reduce) {
    .pswp-glass { transition: none; }
  }
</style>

<!-- CTA — full-width row, card centered in the page -->
<div class="cta-section">
  <div class="cta-card">
    <h2 class="cta-title">{t('project.ctaTitulo')}</h2>
    <div class="cta-actions">
      <a href={l('/donar')} class="btn-white">{t('project.ctaApoya')}</a>
      <a href={l('/contacto')} class="cta-link">{t('project.ctaHablemos')}</a>
    </div>
  </div>
</div>

<style>
  /* ── Hero back link ─────────────────────────────────────────────── */

  .hero-back {
    font-family: var(--font-mono);
    font-size: var(--fs-11);
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
    margin-bottom: 20px;
    display: inline-block;
    transition: color 150ms;
  }

  .hero-back:hover { color: rgba(255, 255, 255, 0.9); }

  /* ── Hero meta row ───────────────────────────────────────────────── */

  .hero-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 12px;
  }

  .meta-sep {
    color: rgba(255, 255, 255, 0.35);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  /* Status badges inside the hero: solid background, white text */
  .hero-meta :global(.status-activo) {
    background: var(--c-cobalto);
    color: #fff;
  }

  .hero-meta :global(.status-completado) {
    background: var(--c-rosado);
    color: #fff;
  }

  .meta-badge {
    font-family: var(--font-mono);
    font-size: var(--fs-10);
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
    background: rgba(255, 255, 255, 0.14);
    border-radius: 20px;
    padding: 2px 8px;
  }

  /* ── Two-column layout ───────────────────────────────────────────── */

  .project-section { padding-top: 48px; }

  .project-layout {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 48px;
    align-items: start;
  }

  /* ── Stacked prop cards ──────────────────────────────────────────── */

  .project-sidebar {
    position: sticky;
    top: 80px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .prop-card {
    border-radius: 8px;
    padding: 18px 20px;
    border: 1.5px solid;
  }

  .prop-card--rosado {
    background: rgba(230, 34, 79, 0.07);
    border-color: var(--c-rosado);
  }

  .prop-card--cobalto {
    background: rgba(59, 107, 220, 0.07);
    border-color: var(--c-cobalto);
  }

  .prop-card--orange {
    background: rgba(226, 97, 29, 0.08);
    border-color: var(--c-orange);
  }

  .prop-card--aguamarina {
    background: rgba(96, 157, 146, 0.08);
    border-color: var(--c-aguamarina);
  }

  .prop-label {
    font-family: var(--font-mono);
    font-size: var(--fs-10);
    letter-spacing: 0.6px;
    text-transform: uppercase;
    margin-bottom: 6px;
  }

  .prop-card--rosado   .prop-label { color: var(--c-rosado); }
  .prop-card--cobalto .prop-label { color: var(--c-cobalto); }
  .prop-card--orange .prop-label { color: var(--c-orange); }
  .prop-card--aguamarina   .prop-label { color: var(--c-aguamarina); }

  .prop-value {
    font-size: 15px;
    font-weight: 400;
    color: var(--c-black);
    line-height: 1.4;
  }

  .prop-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  /* ── Gallery: justified rows ────────────────────────────────────── */
  /* Each item grows in proportion to its aspect ratio (--r), so every photo
     in a row ends up the same height and nothing is cropped. The ::after
     spacer soaks up the last row so a lone photo doesn't blow up. */

  .gallery-section { padding-top: 8px; padding-bottom: 64px; }

  .gallery-rows {
    --row-h: 260px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }

  .gallery-rows::after {
    content: '';
    flex-grow: 999;
  }

  .gallery-item {
    flex: var(--r) 1 calc(var(--r) * var(--row-h));
    aspect-ratio: var(--r);
    max-height: 80vh;
    overflow: hidden;
    border-radius: 6px;
    background: rgba(0, 0, 0, 0.05);
    cursor: zoom-in;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 300ms ease;
  }

  .gallery-item:hover img { transform: scale(1.03); }

  .gallery-item:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  /* ── CTA ─────────────────────────────────────────────────────────── */

  .cta-section {
    padding: 64px 48px;
    display: flex;
    justify-content: center;
  }

  .cta-card {
    border-radius: 8px;
    padding: 32px 40px;
    background: var(--c-grad-hero);
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
  }

  .cta-title {
    font-family: var(--font-display);
    font-variation-settings: var(--font-display-axes);
    font-size: clamp(22px, 2.5vw, 30px);
    font-weight: var(--font-display-weight);
    line-height: 1.1;
    letter-spacing: -0.8px;
    color: #fff;
    margin: 0;
  }

  .cta-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .cta-link {
    font-size: 15px;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
    transition: color 150ms;
  }

  .cta-link:hover { color: #fff; }

  /* ── Responsive ──────────────────────────────────────────────────── */

  @media (max-width: 768px) {
    .project-layout { grid-template-columns: 1fr; gap: 32px; }
    .project-sidebar { position: static; }
    .gallery-rows { --row-h: 160px; }
  }

  @media (max-width: 560px) {
    .gallery-rows { --row-h: 120px; gap: 6px; }
  }
</style>
