---
import PageHero from './layout/PageHero.astro';
import PortableTextBody from './PortableTextBody.tsx';
import { pageLang, useTranslations, localizePath } from '../i18n/ui';
import { statusLabel } from '../i18n/categories';

interface Props {
  title: string;
  /** Already-localized category label. */
  category: string;
  heroImage: string;
  description: any[];
  neighborhood: string;
  partners: string[];
  year: number;
  status: string;
  gallery: string[];
}

const { title, category, heroImage, description, neighborhood, partners, year, status, gallery } = Astro.props;

const lang = pageLang(Astro.currentLocale);
const t = useTranslations(lang);
const l = (path: string) => localizePath(lang, path);

const isActive = status === 'activo';
---

<!-- Hero with image background, no eyebrow -->
<PageHero image={heroImage}>
  <a href={l('/proyectos')} class="hero-back">{t('project.volver')}</a>
  <h1 class="page-hero-title">{title}</h1>
  <div class="hero-meta">
    <span class:list={['status-badge', { 'status-activo': isActive, 'status-completado': !isActive }]}>
      {statusLabel(status, lang)}
    </span>
    <span class="meta-sep">·</span>
    <span class="meta-badge">{category}</span>
    <span class="meta-sep">·</span>
    <span class="meta-badge">{year}</span>
  </div>
</PageHero>

<!-- Two-column: description + stacked prop cards -->
<div class="section project-section">
  <div class="project-layout">

    <div class="project-body">
      <PortableTextBody value={description} />
    </div>

    <aside class="project-sidebar">

      {neighborhood && (
        <div class="prop-card prop-card--rosado">
          <div class="prop-label">{t('project.territorio')}</div>
          <div class="prop-value">{neighborhood}</div>
        </div>
      )}

      <div class="prop-card prop-card--cobalto">
        <div class="prop-label">{t('project.ano')}</div>
        <div class="prop-value">{year}</div>
      </div>

      {partners.length > 0 && (
        <div class="prop-card prop-card--orange">
          <div class="prop-label">{t('project.aliados')}</div>
          <ul class="prop-list">
            {partners.map((p) => <li class="prop-value">{p}</li>)}
          </ul>
        </div>
      )}


    </aside>

  </div>
</div>

<!-- Gallery mosaic — full width, below the two-col -->
{gallery.length > 0 && (
  <div class="section gallery-section">
    <span class="eyebrow">{t('project.galeria')}</span>
    <div class="gallery-mosaic">
      {gallery.map((img, i) => (
        <div class:list={[
          'mosaic-item',
          { 'mosaic-wide': i % 5 === 0 },
          { 'mosaic-tall': i % 5 === 1 },
        ]}>
          <img src={img} alt="" loading="lazy" />
        </div>
      ))}
    </div>
  </div>
)}

<!-- CTA — full-width row, card centered in the page -->
<div class="cta-section">
  <div class="cta-card">
    <h2 class="cta-title">{t('project.ctaTitulo')}</h2>
    <div class="cta-actions">
      <a href={l('/donar')} class="btn-white">{t('project.ctaApoya')}</a>
      <a href={l('/contacto')} class="cta-link">{t('project.ctaHablemos')}</a>
    </div>
  </div>
</div>

<style>
  /* ── Hero back link ─────────────────────────────────────────────── */

  .hero-back {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
    margin-bottom: 20px;
    display: inline-block;
    transition: color 150ms;
  }

  .hero-back:hover { color: rgba(255, 255, 255, 0.9); }

  /* ── Hero meta row ───────────────────────────────────────────────── */

  .hero-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 12px;
  }

  .meta-sep {
    color: rgba(255, 255, 255, 0.35);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  /* Status badges inside the hero: solid background, white text */
  .hero-meta :global(.status-activo) {
    background: var(--c-cobalto);
    color: #fff;
  }

  .hero-meta :global(.status-completado) {
    background: var(--c-rosado);
    color: #fff;
  }

  .meta-badge {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
    background: rgba(255, 255, 255, 0.14);
    border-radius: 20px;
    padding: 2px 8px;
  }

  /* ── Two-column layout ───────────────────────────────────────────── */

  .project-section { padding-top: 48px; }

  .project-layout {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 48px;
    align-items: start;
  }

  /* ── Stacked prop cards ──────────────────────────────────────────── */

  .project-sidebar {
    position: sticky;
    top: 80px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .prop-card {
    border-radius: 8px;
    padding: 18px 20px;
    border: 1.5px solid;
  }

  .prop-card--rosado {
    background: rgba(230, 34, 79, 0.07);
    border-color: var(--c-rosado);
  }

  .prop-card--cobalto {
    background: rgba(59, 107, 220, 0.07);
    border-color: var(--c-cobalto);
  }

  .prop-card--orange {
    background: rgba(226, 97, 29, 0.08);
    border-color: var(--c-orange);
  }

  .prop-card--aguamarina {
    background: rgba(96, 157, 146, 0.08);
    border-color: var(--c-aguamarina);
  }

  .prop-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    margin-bottom: 6px;
  }

  .prop-card--rosado   .prop-label { color: var(--c-rosado); }
  .prop-card--cobalto .prop-label { color: var(--c-cobalto); }
  .prop-card--orange .prop-label { color: var(--c-orange); }
  .prop-card--aguamarina   .prop-label { color: var(--c-aguamarina); }

  .prop-value {
    font-size: 15px;
    font-weight: 400;
    color: var(--c-black);
    line-height: 1.4;
  }

  .prop-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  /* ── Gallery mosaic ──────────────────────────────────────────────── */

  .gallery-section { padding-top: 8px; padding-bottom: 64px; }

  .gallery-mosaic {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 240px;
    gap: 8px;
    margin-top: 20px;
  }

  .mosaic-item {
    overflow: hidden;
    border-radius: 6px;
  }

  .mosaic-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 300ms ease;
  }

  .mosaic-item:hover img { transform: scale(1.03); }

  /* Every 5th group: 1st item wide, 2nd item tall */
  .mosaic-wide { grid-column: span 2; }
  .mosaic-tall { grid-row: span 2; }

  /* ── CTA ─────────────────────────────────────────────────────────── */

  .cta-section {
    padding: 64px 48px;
    display: flex;
    justify-content: center;
  }

  .cta-card {
    border-radius: 8px;
    padding: 32px 40px;
    background: var(--c-grad-hero);
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
  }

  .cta-title {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 144, 'SOFT' 30, 'WONK' 0;
    font-size: clamp(22px, 2.5vw, 30px);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.8px;
    color: #fff;
    margin: 0;
  }

  .cta-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .cta-link {
    font-size: 15px;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
    transition: color 150ms;
  }

  .cta-link:hover { color: #fff; }

  /* ── Responsive ──────────────────────────────────────────────────── */

  @media (max-width: 768px) {
    .project-layout { grid-template-columns: 1fr; gap: 32px; }
    .project-sidebar { position: static; }
    .gallery-mosaic {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 180px;
    }
    .mosaic-wide { grid-column: span 2; }
    .mosaic-tall { grid-row: span 1; }
  }

  @media (max-width: 560px) {
    .gallery-mosaic {
      grid-template-columns: 1fr;
      grid-auto-rows: 200px;
    }
    .mosaic-wide { grid-column: span 1; }
  }
</style>
